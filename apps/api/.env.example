# Confluent API — environment template. Every variable: docs/operations/configuration.md.
# Copy to `.env` for local dev. In production, values come from Doppler or the host's `.env`
# (chmod 600, never committed) — see docs/operations/installation.md.

# Postgres
DATABASE_URL=postgresql://confluent_dev_user:CHANGE_ME@postgres:5432/confluent_dev

# HTTP
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Public address of this API: OAuth issuer and MCP endpoint (`<API_PUBLIC_URL>/mcp`).
API_PUBLIC_URL=http://localhost:3000
# Extra browser origins allowed on /mcp, comma-separated (server-side MCP clients need none).
MCP_ALLOWED_ORIGINS=

# -------- SMTP --------
# Dev local (Mailhog : http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@confluent.local

# Prod : Brevo SMTP relay (Doppler ou .env de l'hôte, NE PAS commiter de creds réels)
# Port 587 : STARTTLS exigé ; 465 : TLS ; 25 : sans TLS, relais local seulement.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=<login Brevo, généralement l'email du compte>
# SMTP_PASSWORD=<clé SMTP générée dans Brevo > SMTP & API>
# SMTP_FROM=<expéditeur vérifié dans Brevo > Senders>

# JWT (32+ bytes recommandés)
JWT_SECRET=dev-secret-change-me-32-bytes-minimum-abc
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-32-bytes-abc

# Stockage des documents : bucket S3 de dev (Garage). Identifiants fournis à part (jamais dans le dépôt).
# STORAGE_DRIVER=memory garde les fichiers en mémoire (perdus à l'arrêt ; refusé en production).
STORAGE_DRIVER=s3
S3_ENDPOINT=<URL du S3 de dev, fournie avec les identifiants>
S3_REGION=garage
S3_BUCKET=confluent-dev
S3_ACCESS_KEY=<clé d'accès du bucket de dev>
S3_SECRET_KEY=<secret du bucket de dev>

# Swagger (/api/docs). En production : HTTP Basic, et jamais servi avec le mot de passe par défaut.
SWAGGER_ENABLED=true
SWAGGER_USER=admin
# SWAGGER_PASSWORD=<8 caractères au moins>

# Purge de conservation (E10.10), en minutes ; 0 la désactive.
RETENTION_PURGE_INTERVAL_MINUTES=360
