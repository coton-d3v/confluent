generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum user_role {
  entrepreneur
  financeur
  admin

  @@map("user_role")
}

enum share_link_status {
  pending
  active
  revoked
  expired

  @@map("share_link_status")
}

enum field_type {
  text
  textarea
  email
  number
  date
  select
  checkbox
  file

  @@map("field_type")
}

enum audit_action {
  magic_link_requested
  magic_link_consumed
  share_link_created
  share_link_viewed
  share_link_revoked
  dossier_created
  dossier_updated
  dossier_classified
  questionnaire_version_published
  user_deactivated
  user_reactivated
  rate_limit_exceeded
  share_link_access_denied
  share_link_access_requested
  admin_edited_field
  admin_uploaded_document
  admin_revoked_share_link
  session_revoked
  refresh_token_reused
  oauth_grant_created
  oauth_grant_revoked
  oauth_refresh_token_reused
  mcp_tool_called
  form_created
  form_updated
  form_draft_created
  form_draft_discarded
  classification_rules_updated
  dossier_submitted
  workspace_created
  workspace_updated
  workspace_member_invited
  workspace_member_updated
  workspace_member_deactivated
  workspace_member_reactivated
  document_type_changed
  document_version_restored
  dossier_published
  dossier_unpublished
  dossier_document_selected
  dossier_document_unselected
  company_prepared
  company_transfer_invited
  company_transfer_accepted
  company_transfer_declined
  company_transfer_cancelled
  candidature_created
  candidature_submitted
  candidature_withdrawn
  dossier_archived
  dossier_unarchived
  candidature_status_changed
  funding_source_categories_updated
  funding_plan_updated
  eligibility_schemes_updated
  candidature_eligibility_updated
  support_steps_updated
  candidature_support_step_updated
  candidature_note_updated
  share_link_level_changed
  pool_publication_published
  pool_publication_withdrawn
  // E07.03: an investor read one of their opportunities (one entry per reading).
  opportunity_viewed
  // E07.05: an investor marked their interest in a request, or changed whether their name shows.
  investor_interest_marked
  // E07.05: an investor withdrew their mark of interest.
  investor_interest_withdrawn
  // E07.06: an investor made or changed their pledge (or hid their name or amount on it).
  investor_pledge_set
  // E07.06: an investor withdrew their pledge.
  investor_pledge_withdrawn
  // E07.07: an investor consented to show their position on a request to a structure.
  investor_position_disclosed
  // E07.07: an investor withdrew that consent.
  investor_position_disclosure_withdrawn
  // E08.01: a workspace manager created a committee.
  committee_created
  // E08.01: a manager edited a committee (name, schedule, place or information).
  committee_updated
  // E08.01: a manager cancelled a committee, marked it held, or put it back to planned.
  committee_status_changed
  // E08.03: a request applied to, was proposed for, accepted at, refused at or withdrawn from a
  // committee.
  committee_application_changed
  // E08.04: someone asked, from the public form, to take part in committees (recorded or merged
  // into their pending request).
  participation_request_received
  // E08.04: a public submission set aside without being recorded (robot field, too many for one
  // address).
  participation_request_discarded
  // E08.05: a manager accepted or refused a participation request.
  participation_request_decided
  // E09.02: a request's owner consented to show its anonymous card on a workspace's public page (a
  // first consent, a new one after a withdrawal, or a change of pseudonym or region).
  showcase_card_published
  // E09.02: that consent withdrawn (by the owner, or with the archiving of the request).
  showcase_card_withdrawn
  showcase_card_hidden
  showcase_card_unhidden
  // E09.05: someone asked, from a workspace's public page, for access to its candidature path
  // (recorded or merged into their pending request).
  entrepreneur_access_request_received
  // E09.05: such a submission set aside without being recorded (robot field, too many for one
  // address).
  entrepreneur_access_request_discarded
  // E09.05: a manager accepted or refused such a request.
  entrepreneur_access_request_decided
  // E10.10: a person downloaded their personal data.
  personal_data_exported
  // E10.10: a person asked for the deletion of their account, or withdrew that request.
  account_deletion_requested
  account_deletion_cancelled
  // E10.10: an administrator declined a deletion request, or processed it (the account deleted).
  account_deletion_declined
  account_deleted

  @@map("audit_action")
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  role            user_role
  isActive        Boolean   @default(true) @map("is_active")
  emailVerifiedAt DateTime? @map("email_verified_at")
  locale          String    @default("fr")
  firstName       String?   @map("first_name")
  lastName        String?   @map("last_name")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  companies        Company[]
  dossiers         Dossier[]
  magicLinkTokens  MagicLinkToken[]
  refreshSessions  RefreshSession[]
  oauthGrants      OAuthGrant[]
  auditLogsAsActor AuditLog[]              @relation("AuditLogActor")
  answersWritten   DossierAnswer[]
  revisionsWritten DossierAnswerRevision[]
  memberships      WorkspaceMembership[]   @relation("WorkspaceMember")
  membersInvited   WorkspaceMembership[]   @relation("WorkspaceMemberInviter")
  transfersOffered CompanyTransfer[]       @relation("CompanyTransferFrom")
  transfersToMe    CompanyTransfer[]       @relation("CompanyTransferTo")

  candidatureAnswersWritten   CandidatureAnswer[]
  candidatureRevisionsWritten CandidatureAnswerRevision[]
  candidatureStatusChanges    CandidatureStatusChange[]
  fundingPlanLinesWritten     FundingPlanLine[]
  eligibilitiesWritten        CandidatureEligibility[]          @relation("EligibilityWriter")
  eligibilitiesVerified       CandidatureEligibility[]          @relation("EligibilityVerifier")
  supportStepsValidated       CandidatureStepValidation[]
  supportStepChanges          CandidatureStepValidationChange[]
  candidatureNotesWritten     CandidatureNote[]
  poolPublicationsConsented   PoolPublication[]                 @relation("PoolPublicationConsenter")
  poolPublicationsWithdrawn   PoolPublication[]                 @relation("PoolPublicationWithdrawer")
  interestsMarked             InvestorInterest[]
  pledgesMade                 InvestorPledge[]
  pledgesConfirmed            FundingPlanPledgeLink[]
  positionDisclosures         InvestorPositionDisclosure[]
  readingSessions             ReadingSession[]
  committeeApplicationChanges CommitteeApplication[]
  participationDecisions      ParticipationRequest[]            @relation("ParticipationDecider")
  participationAdmissions     ParticipationRequest[]            @relation("ParticipationMember")
  notifications               Notification[]
  showcaseCardsConsented      ShowcaseCard[]                    @relation("ShowcaseCardConsenter")
  showcaseCardsWithdrawn      ShowcaseCard[]                    @relation("ShowcaseCardWithdrawer")
  showcaseCardsHidden         ShowcaseCard[]                    @relation("ShowcaseCardHider")
  accessRequestDecisions      EntrepreneurAccessRequest[]       @relation("EntrepreneurAccessDecider")
  accessRequestAdmissions     EntrepreneurAccessRequest[]       @relation("EntrepreneurAccessAccount")
  deletionRequests            AccountDeletionRequest[]          @relation("DeletionRequester")
  deletionDecisions           AccountDeletionRequest[]          @relation("DeletionDecider")

  @@map("users")
}

// One row per issued refresh token (its JWT `jti`). Rotation revokes the presented row and links it
// to its successor; all rows of a login share a `familyId`, so presenting an already-rotated token
// (theft/replay) revokes the whole family.
model RefreshSession {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  familyId     String    @map("family_id")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_sessions")
}

model MagicLinkToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  token      String    @unique
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("magic_link_tokens")
}

// A form definition (ROADMAP E03.01). `usage` says what its answers describe. Confluent's own forms
// (`workspaceId` null) are designed by its administrators: `dossier`, the common company profile
// (D01). A workspace's own forms (E05.09) are designed by its managers: `candidature`, the
// complementary form each candidature to the workspace answers. Closed values and the pairing of
// usage and owner: CHECK constraint; one form per usage — per workspace for `candidature` — partial
// unique indexes (migration 20261115000000_workspace_forms).
model Questionnaire {
  id          String    @id @default(uuid())
  slug        String    @unique
  name        String
  // Business usage the form is assigned to (E03.09), null when unassigned.
  usage       String?
  workspaceId String?   @map("workspace_id")
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace Workspace?             @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  versions  QuestionnaireVersion[]

  @@index([workspaceId])
  @@map("questionnaires")
}

// One version of a form. `status`: draft (editable, unused) → published (exactly one per form, used for
// new dossiers, immutable) → archived (kept for the dossiers created with it). See E03.02/E03.08.
model QuestionnaireVersion {
  id              String    @id @default(uuid())
  questionnaireId String    @map("questionnaire_id")
  version         Int
  // At most one draft and one published version per form (partial unique indexes, migration
  // 20261109030000_form_builder): only the draft is editable.
  status          String    @default("draft")
  publishedAt     DateTime? @map("published_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  questionnaire Questionnaire          @relation(fields: [questionnaireId], references: [id])
  sections      QuestionnaireSection[]
  fields        QuestionnaireField[]
  dossiers      Dossier[]
  companies     Company[]
  candidatures  Candidature[]

  @@unique([questionnaireId, version])
  @@index([questionnaireId, status])
  @@map("questionnaire_versions")
}

// Ordered section of a version; `key` is stable across versions (E03.03, E03.06).
model QuestionnaireSection {
  id         String @id @default(uuid())
  versionId  String @map("version_id")
  key        String
  title      String
  orderIndex Int    @map("order_index")

  version QuestionnaireVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  fields  QuestionnaireField[]

  @@unique([versionId, key])
  @@map("questionnaire_sections")
}

model QuestionnaireField {
  id             String     @id @default(uuid())
  versionId      String     @map("version_id")
  sectionId      String     @map("section_id")
  // Stable technical identifier (E03.06): classification and integrations read it; labels may change.
  key            String
  label          String
  helpText       String?    @map("help_text")
  fieldType      field_type @map("field_type")
  // Choices of a `select` field (E03.06): [{ "key": "seed", "label": "Seed – investisseurs" }].
  // Answers store the choice key, so renaming a label never changes how an answer is read.
  choices        Json       @default("[]")
  required       Boolean    @default(false)
  orderIndex     Int        @map("order_index")
  // Type-specific limits (E03.05), e.g. { "maxLength": 500 } or { "min": 0, "max": 100 }.
  constraints    Json       @default("{}")
  // Lowest share access level (public < partiel < complet) that may read this field's answers.
  // Defaults to the most restrictive level: a field nobody classified stays hidden from financeurs.
  minAccessLevel String     @default("complet") @map("min_access_level")

  version            QuestionnaireVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  section            QuestionnaireSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  answers            DossierAnswer[]
  candidatureAnswers CandidatureAnswer[]
  documents          LibraryDocument[]

  @@unique([versionId, key])
  @@index([versionId, orderIndex])
  @@map("questionnaire_fields")
}

// The company an entrepreneur presents (ROADMAP E05.04): owner of the common profile (D01) and,
// from E05.06, of the document library; its financing dossiers are `dossiers`. It belongs to no
// workspace (it applies to several). Since E05.05 the profile is the company's: the form version it
// answers (`profileVersionId`), its answers and their history, its documents. Name format: CHECK
// constraint (migration 20261112000000_companies).
//
// E05.08: a conseiller may prepare a company for an entrepreneur. While `preparedInWorkspaceId` is
// set, its owner is that conseiller, who holds it for the workspace and reaches it only while an
// active conseiller there; the entrepreneur becomes its owner by accepting a transfer (`transfers`),
// which changes `ownerId` — the dossiers follow by their composite foreign key — and clears
// `preparedInWorkspaceId`. A prepared company is neither shared nor published.
model Company {
  id                    String   @id @default(uuid())
  ownerId               String   @map("owner_id")
  name                  String
  // The version of the company-profile form its answers belong to, kept until an explicit
  // migration of the answers (E03.08). Its dossiers carry a copy the database keeps equal.
  profileVersionId      String   @map("profile_version_id")
  preparedInWorkspaceId String?  @map("prepared_in_workspace_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  owner               User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  profileVersion      QuestionnaireVersion @relation(fields: [profileVersionId], references: [id])
  preparedInWorkspace Workspace?           @relation(fields: [preparedInWorkspaceId], references: [id], onDelete: Restrict)
  transfers           CompanyTransfer[]
  dossiers            Dossier[]            @relation("CompanyDossiers")
  profileDossiers     Dossier[]            @relation("CompanyProfileDossiers")
  answers             DossierAnswer[]
  library             LibraryDocument[]
  documents           Document[]

  // Targets of the dossiers' (company, owner) and (company, profile version) foreign keys.
  @@unique([id, ownerId])
  @@unique([id, profileVersionId])
  @@index([ownerId])
  @@index([profileVersionId])
  @@index([preparedInWorkspaceId])
  @@map("companies")
}

// A transfer of a company's ownership offered to an entrepreneur (ROADMAP E05.08), by the conseiller
// who prepared it in a workspace: the invitation and, once decided, the trace of who gave the company
// to whom, from which workspace and when. `toEmail` is the address the conseiller typed, `toUserId`
// the account behind it (created if unknown). `status`: `pending` (at most one per company) →
// `accepted` | `declined`, or `cancelled` (withdrawn or replaced by the conseiller) | `expired`
// (replaced after `expiresAt`); a pending one past `expiresAt` can no longer be decided. Closed
// values and formats: CHECK constraints (migration 20261114000000_company_transfers).
model CompanyTransfer {
  id          String    @id @default(uuid())
  companyId   String    @map("company_id")
  workspaceId String    @map("workspace_id")
  // Null once that account is deleted; the journal keeps who it was.
  fromUserId  String?   @map("from_user_id")
  toUserId    String    @map("to_user_id")
  toEmail     String    @map("to_email")
  status      String    @default("pending")
  expiresAt   DateTime  @map("expires_at")
  decidedAt   DateTime? @map("decided_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  fromUser  User?     @relation("CompanyTransferFrom", fields: [fromUserId], references: [id], onDelete: SetNull)
  toUser    User      @relation("CompanyTransferTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([workspaceId])
  @@index([fromUserId])
  @@index([toUserId])
  @@map("company_transfers")
}

// A financing dossier of a company (ROADMAP E05.04): one precise financing request (E05.07), several
// per company. It presents its company's profile (answers, E05.05) and the documents of the library
// it selects (`documentSelection`); it keeps its own title (`name`), slug, presentation, publication,
// submission, classification, shares and journal. Formats and closed values: CHECK constraints
// (migration 20261113000000_financing_requests).
model Dossier {
  id                     String    @id @default(uuid())
  // The owner of the company, never set on its own: the (company_id, user_id) foreign key keeps it
  // equal to `companies.owner_id`, and a change of owner (E05.08) cascades to it.
  userId                 String    @map("user_id")
  companyId              String    @map("company_id")
  name                   String
  slug                   String    @unique
  // The company's profile version, never set on its own: the (company_id, questionnaire_version_id)
  // foreign key keeps it equal to `companies.profile_version_id` (E05.05).
  questionnaireVersionId String    @map("questionnaire_version_id")
  sector                 String?
  maturityStage          String?   @map("maturity_stage")
  ancrageCvl             String?   @map("ancrage_cvl")
  tagTechnologique       String?   @map("tag_technologique")
  axe1Projet             Int?      @map("axe1_projet")
  axe2Financier          Int?      @map("axe2_financier")
  axe3Origine            Int?      @map("axe3_origine")
  deeptechScore          Int?      @map("deeptech_score")
  preCreation            Boolean?  @map("pre_creation")
  // Field keys each classification column was computed from, recorded with the values (code
  // review R31): what a share may see is judged on them, not on the rules as they are now.
  classificationSources  Json?     @map("classification_sources")
  submittedAt            DateTime? @map("submitted_at")
  // The request's presentation (E05.07), plain text never rendered as HTML; shown to the recipients
  // of the dossier's shares once it is published.
  summary                String?
  objective              String?
  description            String?
  // Whole euros.
  amountEur              Int?      @map("amount_eur")
  // FINANCING_TYPES of @confluent/shared, without duplicates.
  financingTypes         String[]  @default([]) @map("financing_types")
  // DOSSIER_PUBLICATION_STATUSES of @confluent/shared (D03, E06.01): `draft` | `published` |
  // `archived`; `publishedAt` is set exactly while published, `archivedAt` exactly while archived.
  publicationStatus      String    @default("draft") @map("publication_status")
  publishedAt            DateTime? @map("published_at")
  archivedAt             DateTime? @map("archived_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  user                 User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // NoAction: a company keeps its dossiers (checked at the end of the statement, so deleting an
  // account still removes both).
  company              Company                      @relation("CompanyDossiers", fields: [companyId, userId], references: [id, ownerId], onDelete: NoAction, onUpdate: Cascade)
  companyProfile       Company                      @relation("CompanyProfileDossiers", fields: [companyId, questionnaireVersionId], references: [id, profileVersionId], onDelete: NoAction, onUpdate: Cascade)
  questionnaireVersion QuestionnaireVersion         @relation(fields: [questionnaireVersionId], references: [id])
  shareLinks           ShareLink[]
  auditLogs            AuditLog[]
  documentSelection    DossierDocument[]
  candidatures         Candidature[]
  investorInterests    InvestorInterest[]
  investorPledges      InvestorPledge[]
  positionDisclosures  InvestorPositionDisclosure[]
  readingSessions      ReadingSession[]
  // E10.03: the notifications about it.
  notifications        Notification[]

  // Target of the selection's (dossier, company) foreign key.
  @@unique([id, companyId])
  @@index([userId])
  @@index([companyId])
  @@index([slug])
  @@map("dossiers")
}

// A document of the company's library (ROADMAP E05.06): a file name, answering one attachment
// field of the company-profile form or none (code review R48), with a type and its successive
// versions (`documents`). A file deposited under the same name for the same field is a new version
// of it. Unique per (company, field, name) — the index cannot hold for a NULL field, so documents
// are created under the profile's lock. Type: CHECK constraint `library_documents_type_check`
// (DOCUMENT_TYPES in @confluent/shared).
model LibraryDocument {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  fieldId   String?  @map("field_id")
  filename  String
  type      String   @default("other")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company    Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // The field's read level applies to every version (E03.11).
  field      QuestionnaireField? @relation(fields: [fieldId], references: [id], onDelete: SetNull)
  versions   Document[]
  selections DossierDocument[]

  @@unique([companyId, fieldId, filename])
  // Target of the versions' (document, company, name) foreign key.
  @@unique([id, companyId, filename])
  // Target of the selections' (document, company) foreign key.
  @@unique([id, companyId])
  @@index([fieldId])
  @@map("library_documents")
}

// One version of a library document (E05.06; before, each row was a version identified by its
// company, field and name). Versions are never changed nor deleted by the application: bringing an
// earlier version back adds a new version pointing at the same stored object (`restoredFromId`), so
// a stored object may be shared by several versions and must not be deleted while one refers to it.
// `companyId` and `filename` are copies of the document's, kept equal by the composite foreign key.
model Document {
  id                String   @id @default(uuid())
  libraryDocumentId String   @map("library_document_id")
  companyId         String   @map("company_id")
  filename          String
  mimetype          String
  storageKey        String   @map("storage_key")
  size              Int
  version           Int      @default(1)
  // The earlier version of the same document this one brought back, null for a deposit.
  restoredFromId    String?  @map("restored_from_id")
  createdAt         DateTime @default(now()) @map("created_at")

  libraryDocument             LibraryDocument             @relation(fields: [libraryDocumentId, companyId, filename], references: [id, companyId, filename], onDelete: Cascade, onUpdate: Cascade)
  company                     Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  restoredFrom                Document?                   @relation("DocumentRestorations", fields: [restoredFromId], references: [id], onDelete: SetNull)
  restorations                Document[]                  @relation("DocumentRestorations")
  citedBy                     DossierAnswer[]
  citedByRevisions            DossierAnswerRevision[]
  citedByCandidatureAnswers   CandidatureAnswer[]
  citedByCandidatureRevisions CandidatureAnswerRevision[]
  pinnedBy                    DossierDocument[]

  @@unique([libraryDocumentId, version])
  // Target of the selections' (pinned version, document) foreign key.
  @@unique([id, libraryDocumentId])
  @@index([companyId])
  @@index([restoredFromId])
  @@map("documents")
}

// A document of the company's library selected by one of its dossiers (ROADMAP E05.07): following
// its latest version (`pinnedVersionId` null) or pinned to one of its versions. Only selected
// documents, at that version, reach the recipients of the dossier's shares; the owner keeps the whole
// library. Composite foreign keys hold the dossier, the document and the pinned version in the same
// company and document.
model DossierDocument {
  id                String   @id @default(uuid())
  dossierId         String   @map("dossier_id")
  companyId         String   @map("company_id")
  libraryDocumentId String   @map("library_document_id")
  pinnedVersionId   String?  @map("pinned_version_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  dossier         Dossier         @relation(fields: [dossierId, companyId], references: [id, companyId], onDelete: Cascade, onUpdate: Cascade)
  libraryDocument LibraryDocument @relation(fields: [libraryDocumentId, companyId], references: [id, companyId], onDelete: Cascade, onUpdate: Cascade)
  pinnedVersion   Document?       @relation(fields: [pinnedVersionId, libraryDocumentId], references: [id, libraryDocumentId], onDelete: Cascade, onUpdate: Cascade)

  @@unique([dossierId, libraryDocumentId])
  @@index([libraryDocumentId])
  @@index([pinnedVersionId])
  @@map("dossier_documents")
}

// An answer of a company's profile (E05.05: moved from the dossier to its company, same rows, same
// ids), read through any of its dossiers.
model DossierAnswer {
  id               String   @id @default(uuid())
  companyId        String   @map("company_id")
  fieldId          String   @map("field_id")
  value            String
  // Provenance of the current value (E04.04), rewritten with it; all null for an answer saved
  // before it was recorded. `updatedAt` is its date. Closed values: see the CHECK constraints.
  origin           String? // human | ai
  confirmation     String? // confirmed | pending
  channel          String? // site | admin | mcp
  authorId         String?  @map("author_id")
  clientName       String?  @map("client_name")
  // Document version the value was taken from, and where Confluent found the cited excerpt.
  sourceDocumentId String?  @map("source_document_id")
  sourceLocation   String?  @map("source_location")
  sourceExcerpt    String?  @map("source_excerpt")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  company        Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  field          QuestionnaireField      @relation(fields: [fieldId], references: [id])
  author         User?                   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  sourceDocument Document?               @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  revisions      DossierAnswerRevision[]

  @@unique([companyId, fieldId])
  @@index([authorId])
  @@index([sourceDocumentId])
  @@map("dossier_answers")
}

// A state an answer held before it gave way (E04.05), kept when an AI assistant is involved: a
// proposal corrected, replaced or confirmed, or a value replaced by a proposal. Same provenance
// columns as `DossierAnswer`; `recordedAt` is when that state was written, `replacedAt` when it
// gave way. Closed values: see the CHECK constraints.
model DossierAnswerRevision {
  id               String   @id @default(uuid())
  answerId         String   @map("answer_id")
  value            String
  origin           String? // human | ai
  confirmation     String? // confirmed | pending
  channel          String? // site | admin | mcp
  authorId         String?  @map("author_id")
  clientName       String?  @map("client_name")
  sourceDocumentId String?  @map("source_document_id")
  sourceLocation   String?  @map("source_location")
  sourceExcerpt    String?  @map("source_excerpt")
  recordedAt       DateTime @map("recorded_at")
  replacedAt       DateTime @default(now()) @map("replaced_at")

  answer         DossierAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  author         User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  sourceDocument Document?     @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  @@index([answerId])
  @@index([authorId])
  @@index([sourceDocumentId])
  @@map("dossier_answer_revisions")
}

// A candidature (ROADMAP E05.09; glossary « Candidature au workspace »): one financing request
// presented to one workspace, at most once. It presents its company's common profile as is (D01) and
// answers the workspace's complementary form, at the version published when it was created
// (`formVersionId`, kept until an explicit migration of its answers, E03.08). Its answers are its
// own and private to it. A draft (`submittedAt` null) is its owner's alone; once submitted, the
// workspace's conseillers read it. It goes with its dossier.
model Candidature {
  id                       String    @id @default(uuid())
  dossierId                String    @map("dossier_id")
  workspaceId              String    @map("workspace_id")
  formVersionId            String    @map("form_version_id")
  submittedAt              DateTime? @map("submitted_at")
  // The request's financing status in this workspace (D03, E06.01): FINANCING_STATUSES of
  // @confluent/shared, `preparing` until the candidature is sent; changed only through
  // `CandidaturesService.changeFinancingStatus`, each change kept in `candidature_status_changes`.
  financingStatus          String    @default("preparing") @map("financing_status")
  financingStatusChangedAt DateTime  @default(now()) @map("financing_status_changed_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  dossier               Dossier                     @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  workspace             Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  formVersion           QuestionnaireVersion        @relation(fields: [formVersionId], references: [id])
  answers               CandidatureAnswer[]
  statusChanges         CandidatureStatusChange[]
  planLines             FundingPlanLine[]
  eligibilities         CandidatureEligibility[]
  stepValidations       CandidatureStepValidation[]
  notes                 CandidatureNote[]
  // At most one: `pool_publications.candidature_id` is unique.
  poolPublications      PoolPublication[]
  pledgeLinks           FundingPlanPledgeLink[]
  // E08.03: its entries on the committees of its workspace.
  committeeApplications CommitteeApplication[]
  // E09.02: at most one — `showcase_cards.candidature_id` is unique.
  showcaseCards         ShowcaseCard[]

  @@unique([dossierId, workspaceId])
  // Target of the (candidature, workspace) foreign keys of plan lines, eligibilities, step
  // validations and internal notes (E06.03, E06.05, E06.06, E06.08).
  @@unique([id, workspaceId])
  // Target of the (candidature, request) foreign key of the pledges confirmed in its plan (E06.04).
  @@unique([id, dossierId])
  @@index([workspaceId])
  @@index([formVersionId])
  @@map("candidatures")
}

// One change of a candidature's financing status (E06.01): from, to, which side (`owner` |
// `workspace`), who and when. Written with the change, under the candidature's lock; never updated.
model CandidatureStatusChange {
  id            String   @id @default(uuid())
  candidatureId String   @map("candidature_id")
  fromStatus    String   @map("from_status")
  toStatus      String   @map("to_status")
  actorSide     String   @map("actor_side")
  actorId       String?  @map("actor_id")
  changedAt     DateTime @default(now()) @map("changed_at")

  candidature Candidature @relation(fields: [candidatureId], references: [id], onDelete: Cascade)
  actor       User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([candidatureId])
  @@index([actorId])
  @@map("candidature_status_changes")
}

// An answer of a candidature to its workspace's complementary form (E05.09), with the provenance of
// its current value (E04.04): the same columns, rules and CHECK constraints as `DossierAnswer`.
model CandidatureAnswer {
  id               String   @id @default(uuid())
  candidatureId    String   @map("candidature_id")
  fieldId          String   @map("field_id")
  value            String
  origin           String? // human | ai
  confirmation     String? // confirmed | pending
  channel          String? // site | admin | mcp
  authorId         String?  @map("author_id")
  clientName       String?  @map("client_name")
  sourceDocumentId String?  @map("source_document_id")
  sourceLocation   String?  @map("source_location")
  sourceExcerpt    String?  @map("source_excerpt")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  candidature    Candidature                 @relation(fields: [candidatureId], references: [id], onDelete: Cascade)
  field          QuestionnaireField          @relation(fields: [fieldId], references: [id])
  author         User?                       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  sourceDocument Document?                   @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  revisions      CandidatureAnswerRevision[]

  @@unique([candidatureId, fieldId])
  @@index([fieldId])
  @@index([authorId])
  @@index([sourceDocumentId])
  @@map("candidature_answers")
}

// A state a candidature's answer held before it gave way, kept when an AI assistant is involved
// (E04.05): same columns and rules as `DossierAnswerRevision`.
model CandidatureAnswerRevision {
  id               String   @id @default(uuid())
  answerId         String   @map("answer_id")
  value            String
  origin           String? // human | ai
  confirmation     String? // confirmed | pending
  channel          String? // site | admin | mcp
  authorId         String?  @map("author_id")
  clientName       String?  @map("client_name")
  sourceDocumentId String?  @map("source_document_id")
  sourceLocation   String?  @map("source_location")
  sourceExcerpt    String?  @map("source_excerpt")
  recordedAt       DateTime @map("recorded_at")
  replacedAt       DateTime @default(now()) @map("replaced_at")

  answer         CandidatureAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  author         User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  sourceDocument Document?         @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  @@index([answerId])
  @@index([authorId])
  @@index([sourceDocumentId])
  @@map("candidature_answer_revisions")
}

model ShareLink {
  id             String            @id @default(uuid())
  dossierId      String            @map("dossier_id")
  recipientEmail String            @map("recipient_email")
  token          String            @unique
  status         share_link_status @default(pending)
  accessLevel    String            @default("complet") @map("access_level")
  createdAt      DateTime          @default(now()) @map("created_at")
  revokedAt      DateTime?         @map("revoked_at")

  dossier         Dossier          @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  auditLogs       AuditLog[]
  readingSessions ReadingSession[]

  @@index([dossierId])
  @@index([token])
  @@map("share_links")
}

// A reading session of a request (ROADMAP E07.08, rules in @confluent/shared `reading.schema.ts`):
// one view. Opened by the server when a reader loads the request, through `channel` (`share`: the
// page of a share link; `opportunity`: an opportunity, CHECK), and resumed by their next loads of it
// through the same direct share (`share_link_id`, or none) while its last activity is recent. Active
// time (`active_ms`) is credited by the server from the page's heartbeats, bounded by the time elapsed
// (CHECK: 0 to 3 h); `NULL` when not measured — a reading through pools alone, or one taken before
// E07.08. Removed with the request or the share; the reader's account removed, the view stays.
model ReadingSession {
  id          String   @id @default(uuid())
  dossierId   String   @map("dossier_id")
  readerId    String?  @map("reader_id")
  shareLinkId String?  @map("share_link_id")
  channel     String
  startedAt   DateTime @map("started_at")
  lastSeenAt  DateTime @map("last_seen_at")
  activeMs    Int?     @map("active_ms")

  dossier   Dossier    @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  reader    User?      @relation(fields: [readerId], references: [id], onDelete: SetNull)
  shareLink ShareLink? @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)

  // A load looks for the reader's latest session on the request; the owner reads them per share.
  @@index([readerId, dossierId, lastSeenAt])
  @@index([shareLinkId])
  @@index([dossierId])
  @@map("reading_sessions")
}

model AuditLog {
  id          String       @id @default(uuid())
  dossierId   String?      @map("dossier_id")
  actorId     String?      @map("actor_id")
  shareLinkId String?      @map("share_link_id")
  actionType  audit_action @map("action_type")
  metadata    Json         @default("{}")
  createdAt   DateTime     @default(now()) @map("created_at")

  dossier   Dossier?   @relation(fields: [dossierId], references: [id], onDelete: SetNull)
  actor     User?      @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  shareLink ShareLink? @relation(fields: [shareLinkId], references: [id], onDelete: SetNull)

  @@index([dossierId])
  @@index([actorId])
  @@index([createdAt])
  // E10.08: a request's revoked shares and who revoked them are read by share (`accessList`, at
  // every load of the owner's page and after each revocation): without it, the whole journal is read.
  @@index([shareLinkId])
  @@map("audit_log")
}

// ── OAuth 2.1 authorization server for MCP clients (Claude, ChatGPT…) — roadmap E01.03 ──────────

// A client application. `source`: `dcr` (RFC 7591 registration) or `cimd` (client_id is an HTTPS URL
// whose metadata document was fetched). `clientSecret` is only set for confidential DCR clients: the
// MCP SDK compares it verbatim, so it cannot be hashed.
model OAuthClient {
  id                      String    @id
  source                  String
  name                    String
  redirectUris            String[]  @map("redirect_uris")
  tokenEndpointAuthMethod String    @default("none") @map("token_endpoint_auth_method")
  clientSecret            String?   @map("client_secret")
  metadata                Json
  fetchedAt               DateTime? @map("fetched_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  authorizationRequests OAuthAuthorizationRequest[]
  grants                OAuthGrant[]

  @@map("oauth_clients")
}

// An /authorize request waiting for the user's consent in the web app (short-lived).
model OAuthAuthorizationRequest {
  id            String    @id @default(uuid())
  clientId      String    @map("client_id")
  redirectUri   String    @map("redirect_uri")
  scopes        String[]
  codeChallenge String    @map("code_challenge")
  state         String?
  resource      String
  expiresAt     DateTime  @map("expires_at")
  decidedAt     DateTime? @map("decided_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("oauth_authorization_requests")
}

// A user's consent to one client = one "connected application". Revoking it kills every token.
model OAuthGrant {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  clientId     String    @map("client_id")
  scopes       String[]
  // E05.10: the workspaces the person allowed the application to reach, among their active
  // memberships at consent time. Never widened afterwards (a refresh keeps the grant); empty for an
  // authorization given before this choice existed (closed by default).
  workspaceIds String[]  @default([]) @map("workspace_ids")
  resource     String
  expiresAt    DateTime  @map("expires_at")
  lastUsedAt   DateTime? @map("last_used_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  client OAuthClient  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tokens OAuthToken[]

  @@index([userId])
  @@map("oauth_grants")
}

// Authorization codes, access and refresh tokens of a grant. Only the SHA-256 of the opaque value
// is stored. `codeChallenge`/`redirectUri` are set for codes only.
model OAuthToken {
  id            String    @id @default(uuid())
  grantId       String    @map("grant_id")
  kind          String
  tokenHash     String    @unique @map("token_hash")
  // Scopes this token carries (a refresh may narrow them; never widen).
  scopes        String[]  @default([])
  codeChallenge String?   @map("code_challenge")
  redirectUri   String?   @map("redirect_uri")
  expiresAt     DateTime  @map("expires_at")
  usedAt        DateTime? @map("used_at")
  revokedAt     DateTime? @map("revoked_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  grant OAuthGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([grantId])
  @@map("oauth_tokens")
}

// Classification rules (ROADMAP E03.12): which answer (field key, choice key) gives which value of
// a classification dimension. Dimensions and their values are defined in @confluent/shared.
model ClassificationRule {
  id        String   @id @default(uuid())
  dimension String
  fieldKey  String   @map("field_key")
  // '' when the rule reads the whole field (`label` dimensions).
  choiceKey String   @default("") @map("choice_key")
  value     String   @default("")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([dimension, fieldKey, choiceKey])
  @@map("classification_rules")
}

// The space of one structure (CCI, incubator, investor network, club deal) and its settings
// (ROADMAP E05.01). Memberships (E05.02) and isolation (E05.03) attach to it later. Formats and
// closed values are also enforced by CHECK constraints (migration 20261111300000_workspaces).
model Workspace {
  id                  String   @id @default(uuid())
  // Public and stable (`/w/<slug>` page, E09.01): set at creation, never changed.
  slug                String   @unique
  name                String
  programName         String?  @map("program_name")
  // `#rrggbb`.
  color               String?
  // Plain text, never rendered as HTML or Markdown.
  presentation        String?
  contactEmail        String?  @map("contact_email")
  // Lower-case ASCII host name the workspace's invitations are restricted to (applied from E05.02).
  emailDomain         String?  @map("email_domain")
  // Opaque key of the logo in the private bucket (`workspaces/<id>/logo/<uuid>`), served by signed URL
  // to members, and by the public logo route while the public page is published (E09.01).
  logoKey             String?  @map("logo_key")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  // E09.01: its public page (`/w/<slug>`), unpublished until a manager turns it on; criteria and
  // contact in plain text, shown to anyone once published (the presentation above too). The
  // version counts the page's settings, never reused. What the public reads of each column:
  // `WORKSPACE_COLUMN_AUDIENCE` (workspace-pages/workspace-page-views.ts).
  publicPagePublished Boolean  @default(false) @map("public_page_published")
  publicCriteria      String?  @map("public_criteria")
  publicContact       String?  @map("public_contact")
  publicPageVersion   Int      @default(1) @map("public_page_version")
  // E09.04: the blocks of the page shown, in their order (a closed catalogue, each at most once:
  // @confluent/shared `PUBLIC_PAGE_BLOCKS`); by default E09.01's page, every block in its order.
  publicPageBlocks    String[] @default(["presentation", "criteria", "committees", "cards", "apply", "participate", "contact"]) @map("public_page_blocks")
  // E09.06: its managers allow search engines to index the page while it is published; no by default
  // (every page of the site says `noindex` otherwise: @confluent/shared `publicPageRobots`).
  publicPageIndexable Boolean  @default(false) @map("public_page_indexable")

  memberships           WorkspaceMembership[]
  preparedCompanies     Company[]
  companyTransfers      CompanyTransfer[]
  forms                 Questionnaire[]
  candidatures          Candidature[]
  fundingSources        FundingSourceCategory[]
  eligibilitySchemes    EligibilityScheme[]
  supportSteps          SupportStep[]
  // E07.07: the positions its investors consented to show it.
  positionDisclosures   InvestorPositionDisclosure[]
  // E08.01: the committees it organises.
  committees            Committee[]
  // E08.04: the participation requests sent from its public form.
  participationRequests ParticipationRequest[]
  // E09.05: the requests for access to its candidature path sent from its public page.
  accessRequests        EntrepreneurAccessRequest[]
  // E10.03: the notifications about it.
  notifications         Notification[]

  @@map("workspaces")
}

// ROADMAP E06.02, decision D04 (to be confirmed): the categories a workspace splits financing plans
// into, D04's six by default (@confluent/shared `funding-source.schema.ts`). `key` and `family` are
// fixed at creation — what later tasks reference —, `label`, `position` and `active` are the
// managers' configuration. Deactivated, never deleted. CHECK: closed family, key pattern, label
// trimmed and bounded, position ≥ 0.
model FundingSourceCategory {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  key         String
  label       String
  family      String
  position    Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  planLines FundingPlanLine[]

  @@unique([workspaceId, key])
  @@unique([workspaceId, label])
  // Target of the plan lines' (category, workspace) foreign key (E06.03).
  @@unique([id, workspaceId])
  @@map("funding_source_categories")
}

// One line of a candidature's financing plan (ROADMAP E06.03): an amount, in whole euros, and a
// state (FUNDING_PLAN_LINE_STATES of @confluent/shared) for one source category of the
// candidature's workspace — both foreign keys carry `workspace_id`, so a line never uses another
// workspace's category. `version` grows at each change (a change made meanwhile is refused);
// `updatedBySide` says which side wrote it last, `updatedById` who.
model FundingPlanLine {
  id            String   @id @default(uuid())
  candidatureId String   @map("candidature_id")
  workspaceId   String   @map("workspace_id")
  categoryId    String   @map("category_id")
  label         String?
  amountEur     Int      @map("amount_eur")
  state         String
  version       Int      @default(1)
  updatedBySide String   @map("updated_by_side")
  updatedById   String?  @map("updated_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  candidature Candidature             @relation(fields: [candidatureId, workspaceId], references: [id, workspaceId], onDelete: Cascade, onUpdate: NoAction)
  category    FundingSourceCategory   @relation(fields: [categoryId, workspaceId], references: [id, workspaceId], onDelete: Restrict, onUpdate: NoAction)
  updatedBy   User?                   @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  // At most one: `funding_plan_pledge_links.line_id` is unique (E06.04).
  pledgeLinks FundingPlanPledgeLink[]

  // Target of the (line, candidature) foreign key of a pledge confirmed by the line (E06.04).
  @@unique([id, candidatureId])
  @@index([candidatureId])
  @@index([categoryId, workspaceId])
  @@index([updatedById])
  @@map("funding_plan_lines")
}

// ROADMAP E06.05: the schemes (« dispositifs » — JEIR, JEI, CIR…) a workspace records the
// eligibility of its candidatures to, as declarative information and a filter — never a tax
// simulation. Its default list: @confluent/shared `eligibility.schema.ts`. Like the funding source
// categories (E06.02), `key` is fixed at creation; `label`, `description`, `position` and `active`
// are the managers' configuration; deactivated, never deleted. CHECK: key pattern, label and
// description trimmed and bounded, position ≥ 0.
model EligibilityScheme {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  key         String
  label       String
  description String?
  position    Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace     Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  eligibilities CandidatureEligibility[]

  @@unique([workspaceId, key])
  @@unique([workspaceId, label])
  // Target of the eligibilities' (scheme, workspace) foreign key.
  @@unique([id, workspaceId])
  @@map("eligibility_schemes")
}

// ROADMAP E06.05: a candidature's eligibility to one scheme of its workspace, declared by its owner
// or by the workspace (`declaredBySide`), with an optional note; `verifiedAt`/`verifiedById` once
// the workspace says it checked it. Both foreign keys carry `workspace_id`: an eligibility never uses
// another workspace's scheme. One per candidature and scheme; `version` grows at each change (a
// change made meanwhile is refused); `updatedBySide` says which side wrote it last, `updatedById` who.
model CandidatureEligibility {
  id             String    @id @default(uuid())
  candidatureId  String    @map("candidature_id")
  workspaceId    String    @map("workspace_id")
  schemeId       String    @map("scheme_id")
  note           String?
  declaredBySide String    @map("declared_by_side")
  verifiedAt     DateTime? @map("verified_at")
  verifiedById   String?   @map("verified_by_id")
  version        Int       @default(1)
  updatedBySide  String    @map("updated_by_side")
  updatedById    String?   @map("updated_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  candidature Candidature       @relation(fields: [candidatureId, workspaceId], references: [id, workspaceId], onDelete: Cascade, onUpdate: NoAction)
  scheme      EligibilityScheme @relation(fields: [schemeId, workspaceId], references: [id, workspaceId], onDelete: Restrict, onUpdate: NoAction)
  verifiedBy  User?             @relation("EligibilityVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  updatedBy   User?             @relation("EligibilityWriter", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([candidatureId, schemeId])
  @@index([schemeId, workspaceId])
  @@index([verifiedById])
  @@index([updatedById])
  @@map("candidature_eligibilities")
}

// ROADMAP E06.06: one step of a workspace's support path (« parcours d'accompagnement »): `key`
// stable, fixed at creation; `label`, `explanation` (plain text for the entrepreneur), `position` and
// `active` configured by its managers. Deactivated, never deleted (validations refer to it).
model SupportStep {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  key         String
  label       String
  explanation String?
  position    Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace   Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  validations CandidatureStepValidation[]

  @@unique([workspaceId, key])
  @@unique([workspaceId, label])
  // Target of the validations' (step, workspace) foreign key.
  @@unique([id, workspaceId])
  @@map("support_steps")
}

// ROADMAP E06.06: where one step of its workspace's path stands for a candidature — validated
// (`validatedAt`, `validatedById`) or not (never, or its validation withdrawn). Both foreign keys
// carry `workspace_id`: a candidature is only validated on its own workspace's steps. One per
// candidature and step, created at the first validation; `version` grows at each change (a change
// made meanwhile is refused). Its changes are kept in `candidature_step_validation_changes`.
model CandidatureStepValidation {
  id            String    @id @default(uuid())
  candidatureId String    @map("candidature_id")
  workspaceId   String    @map("workspace_id")
  stepId        String    @map("step_id")
  validatedAt   DateTime? @map("validated_at")
  validatedById String?   @map("validated_by_id")
  version       Int       @default(1)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  candidature Candidature                       @relation(fields: [candidatureId, workspaceId], references: [id, workspaceId], onDelete: Cascade, onUpdate: NoAction)
  step        SupportStep                       @relation(fields: [stepId, workspaceId], references: [id, workspaceId], onDelete: Restrict, onUpdate: NoAction)
  validatedBy User?                             @relation(fields: [validatedById], references: [id], onDelete: SetNull)
  changes     CandidatureStepValidationChange[]

  @@unique([candidatureId, stepId])
  @@index([stepId, workspaceId])
  @@index([validatedById])
  @@map("candidature_step_validations")
}

// ROADMAP E06.06: one change of a step's validation — `validated` or `reopened` (validation
// withdrawn) —, who and when. Written with the change, under the candidature's lock; never updated.
model CandidatureStepValidationChange {
  id           String   @id @default(uuid())
  validationId String   @map("validation_id")
  change       String
  actorId      String?  @map("actor_id")
  changedAt    DateTime @default(now()) @map("changed_at")

  validation CandidatureStepValidation @relation(fields: [validationId], references: [id], onDelete: Cascade)
  actor      User?                     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([validationId])
  @@index([actorId])
  @@map("candidature_step_validation_changes")
}

// ROADMAP E06.08: an internal note of the workspace on a candidature it received, read by its
// conseillers alone — never by the entrepreneur, an investor, another workspace, a share recipient
// or an MCP tool. Its foreign key carries `workspace_id`: a note stays inside its candidature's
// workspace. Plain text; rewritten (`editedAt`) or deleted (`deletedAt`, its text erased) by its
// author only, from the `version` they read.
model CandidatureNote {
  id            String    @id @default(uuid())
  candidatureId String    @map("candidature_id")
  workspaceId   String    @map("workspace_id")
  body          String?
  authorId      String?   @map("author_id")
  version       Int       @default(1)
  createdAt     DateTime  @default(now()) @map("created_at")
  editedAt      DateTime? @map("edited_at")
  deletedAt     DateTime? @map("deleted_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  candidature Candidature @relation(fields: [candidatureId, workspaceId], references: [id, workspaceId], onDelete: Cascade, onUpdate: NoAction)
  author      User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([candidatureId, workspaceId])
  @@index([authorId])
  @@map("candidature_notes")
}

// ROADMAP E07.02: the publication of a financing request in the pool (« vivier ») of the workspace
// its candidature is sent to — what that workspace's investors will read (E07.03), at `accessLevel`,
// through the projection of nominative shares. One per candidature, so per (request × workspace);
// its foreign key carries `workspace_id`, so it never lands in another workspace's pool. Published by
// the request's owner alone, by an explicit consent (`consentedAt`, `consentedById`: the latest one
// — first publication, republication or change of level); withdrawn (`withdrawnAt`) by them or with
// the request's archiving (`withdrawalReason`), the row kept; republished by a new consent. Whether
// it is listed: @confluent/shared `poolPublicationState`. Closed values: CHECK constraints (migration
// 20261124000000_pool_publications).
model PoolPublication {
  id               String    @id @default(uuid())
  candidatureId    String    @unique @map("candidature_id")
  workspaceId      String    @map("workspace_id")
  accessLevel      String    @map("access_level")
  consentedAt      DateTime  @map("consented_at")
  consentedById    String?   @map("consented_by_id")
  withdrawnAt      DateTime? @map("withdrawn_at")
  withdrawnById    String?   @map("withdrawn_by_id")
  withdrawalReason String?   @map("withdrawal_reason")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  candidature Candidature @relation(fields: [candidatureId, workspaceId], references: [id, workspaceId], onDelete: Cascade, onUpdate: NoAction)
  consentedBy User?       @relation("PoolPublicationConsenter", fields: [consentedById], references: [id], onDelete: SetNull)
  withdrawnBy User?       @relation("PoolPublicationWithdrawer", fields: [withdrawnById], references: [id], onDelete: SetNull)

  // E07.03 lists a workspace's pool.
  @@index([workspaceId, withdrawnAt])
  @@index([consentedById])
  @@index([withdrawnById])
  @@map("pool_publications")
}

// ROADMAP E09.02: the owner's consent to show an anonymous card of the request on the public page of
// the candidature's workspace (`/w/<slug>`, E09.01), under the pseudonym they chose, with the region
// they chose or none. One per candidature, kept and reused: a new consent after a withdrawal writes
// on it, its version only grows (R63). The foreign key carries `workspace_id`: a card never shows on
// another workspace's page. Rules: @confluent/shared `showcase-card.schema.ts`; what the public reads
// of each column: `SHOWCASE_CARD_COLUMN_AUDIENCE` (showcase-cards/showcase-card-views.ts). CHECK:
// pseudonym one trimmed line of 2 to 60 characters without markup, address or link, closed regions,
// coherent withdrawal, version ≥ 1 (migration 20261208000000_showcase_cards).
model ShowcaseCard {
  id               String    @id @default(uuid())
  candidatureId    String    @unique @map("candidature_id")
  workspaceId      String    @map("workspace_id")
  pseudonym        String
  region           String?
  consentedAt      DateTime  @map("consented_at")
  consentedById    String?   @map("consented_by_id")
  withdrawnAt      DateTime? @map("withdrawn_at")
  withdrawnById    String?   @map("withdrawn_by_id")
  withdrawalReason String?   @map("withdrawal_reason")
  // E09.03: hidden from the workspace's page by one of its managers (null: not hidden), and by whom.
  hiddenAt         DateTime? @map("hidden_at")
  hiddenById       String?   @map("hidden_by_id")
  version          Int       @default(1)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  candidature Candidature @relation(fields: [candidatureId, workspaceId], references: [id, workspaceId], onDelete: Cascade, onUpdate: NoAction)
  consentedBy User?       @relation("ShowcaseCardConsenter", fields: [consentedById], references: [id], onDelete: SetNull)
  withdrawnBy User?       @relation("ShowcaseCardWithdrawer", fields: [withdrawnById], references: [id], onDelete: SetNull)
  hiddenBy    User?       @relation("ShowcaseCardHider", fields: [hiddenById], references: [id], onDelete: SetNull)

  // The cards of a workspace's public page.
  @@index([workspaceId, withdrawnAt])
  @@index([consentedById])
  @@index([withdrawnById])
  @@index([hiddenById])
  @@map("showcase_cards")
}

// An investor's mark of interest in a request (ROADMAP E07.05, rules in @confluent/shared
// `interest.schema.ts`): at most one per investor and request (unique), marked while the investor
// reads the request as an opportunity (E07.03), withdrawn by deleting it (the journal keeps both).
// `name_visible` is the investor's consent to be named to the owner (D05), off by default. Who still
// counts is read at each request, never stored: a mark outlives a lost access, uncounted. Removed
// with the request or the account.
model InvestorInterest {
  id          String   @id @default(uuid())
  dossierId   String   @map("dossier_id")
  investorId  String   @map("investor_id")
  nameVisible Boolean  @default(false) @map("name_visible")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  dossier  Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  investor User    @relation(fields: [investorId], references: [id], onDelete: Cascade)

  @@unique([dossierId, investorId])
  // E07.07 lists an investor's marks.
  @@index([investorId])
  @@map("investor_interests")
}

// An investor's pledge on a request (ROADMAP E07.06, rules in @confluent/shared `pledge.schema.ts`):
// a declarative intention, never a commitment. At most one per investor and request (unique),
// separate from the mark of interest; made and changed while the investor reads the request as an
// opportunity (E07.03) and the request is not archived (its closure), from the `version` read;
// withdrawn by deleting it (the journal keeps both). `show_name` / `show_amount`: the investor's
// consent to show their name / their amount to the owner, with no default. Who still counts is read
// at each request, never stored. Removed with the request or the account.
model InvestorPledge {
  id         String   @id @default(uuid())
  dossierId  String   @map("dossier_id")
  investorId String   @map("investor_id")
  // `exploring` | `likely` | `strong` (CHECK).
  intention  String
  // Whole euros, 1 € to 1 billion (CHECK).
  amountEur  Int      @map("amount_eur")
  // Plain text in paragraphs, at most 1 000 characters (CHECK).
  comment    String?
  showName   Boolean  @map("show_name")
  showAmount Boolean  @map("show_amount")
  version    Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  dossier   Dossier                 @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  investor  User                    @relation(fields: [investorId], references: [id], onDelete: Cascade)
  planLinks FundingPlanPledgeLink[]

  @@unique([dossierId, investorId])
  // Target of the (pledge, request) foreign key of its confirmations in plans (E06.04).
  @@unique([id, dossierId])
  // E07.07 lists an investor's pledges.
  @@index([investorId])
  @@map("investor_pledges")
}

// A pledge confirmed as financing in one candidature's plan (ROADMAP E06.04, rules in
// @confluent/shared `funding-plan.schema.ts`): the line of that plan that now carries it, and the
// pledge's revision (`pledge_version`, opaque, compared for equality only) the owner confirmed. While
// the pledge is still at that revision, the plan counts the line and no longer the pledge; once the
// investor changes it, the pledge counts as promised again. At most one pledge per line and one line
// per pledge in a plan (both unique); the composite foreign keys keep the line in the candidature and
// the pledge on the candidature's request. Removed with the line, the pledge (a withdrawal), the
// candidature or the request; the line itself stays when the pledge goes.
model FundingPlanPledgeLink {
  id            String   @id @default(uuid())
  lineId        String   @unique @map("line_id")
  candidatureId String   @map("candidature_id")
  dossierId     String   @map("dossier_id")
  pledgeId      String   @map("pledge_id")
  pledgeVersion Int      @map("pledge_version")
  confirmedById String?  @map("confirmed_by_id")
  confirmedAt   DateTime @default(now()) @map("confirmed_at")

  line        FundingPlanLine @relation(fields: [lineId, candidatureId], references: [id, candidatureId], onDelete: Cascade, onUpdate: NoAction)
  candidature Candidature     @relation(fields: [candidatureId, dossierId], references: [id, dossierId], onDelete: Cascade, onUpdate: NoAction)
  pledge      InvestorPledge  @relation(fields: [pledgeId, dossierId], references: [id, dossierId], onDelete: Cascade, onUpdate: NoAction)
  confirmedBy User?           @relation(fields: [confirmedById], references: [id], onDelete: SetNull)

  @@unique([candidatureId, pledgeId])
  @@index([pledgeId, dossierId])
  @@index([confirmedById])
  @@map("funding_plan_pledge_links")
}

// An investor's consent to show a structure their position on a request (ROADMAP E07.07, rules in
// @confluent/shared `position.schema.ts`): one per (request, investor, workspace) — unique —, given
// explicitly (no default) on a request the investor reads through that workspace's pool, withdrawn
// by deleting it (the journal keeps both). Whether it still shows anything is read at each request
// (the investor still reads the request through that pool), never stored. Removed with the request,
// the account or the workspace.
model InvestorPositionDisclosure {
  id          String   @id @default(uuid())
  dossierId   String   @map("dossier_id")
  investorId  String   @map("investor_id")
  workspaceId String   @map("workspace_id")
  createdAt   DateTime @default(now()) @map("created_at")

  dossier   Dossier   @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  investor  User      @relation(fields: [investorId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([dossierId, investorId, workspaceId])
  // « Mes positionnements » lists an investor's consents; a structure reads those it was given.
  @@index([investorId])
  @@index([workspaceId, dossierId])
  @@map("investor_position_disclosures")
}

// A person's place in one workspace (ROADMAP E05.02), distinct from the account's global role
// (`users.role`): the global role never grants a workspace right (administrators aside), and a
// membership never changes the global role. Deactivating keeps the row and its history; what it
// grants stops at the next request, since rights are read from this row at each one.
model WorkspaceMembership {
  id                 String    @id @default(uuid())
  workspaceId        String    @map("workspace_id")
  userId             String    @map("user_id")
  // `conseiller` | `investisseur` (CHECK).
  role               String
  organization       String?
  // Investisseurs only (CHECK): `business_angel` | `fonds_investissement` | `banque` |
  // `financeur_public` | `reseau_pret_honneur` | `autre`.
  investorType       String?   @map("investor_type")
  // Conseillers only (CHECK): sets up the workspace and manages its members.
  canManageWorkspace Boolean   @default(false) @map("can_manage_workspace")
  invitedById        String?   @map("invited_by_id")
  deactivatedAt      DateTime? @map("deactivated_at")
  // Date of the invitation.
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("WorkspaceMember", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("WorkspaceMemberInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_memberships")
}

// ROADMAP E08.01: a committee (pitch session) a workspace organises — rules in @confluent/shared
// `committee.schema.ts`. When: the wall-clock start as typed (`localStart`, minute precision, no time
// zone) in the IANA zone `timeZone`, and the instant it designates (`startsAt`), derived by the API
// at each write of the schedule — a time skipped or repeated by a change of offset is refused.
// `status` planned / held / cancelled: cancelling is a status, a committee is never deleted, so its
// `version` (grows at each change, a change made meanwhile is refused) is never reused.
// `internalNotes`: the workspace's own information, read only by those who read its committees.
// CHECK: closed status, trimmed bounded texts, https link, zone name, minute precision, years
// 2000–2099, `startsAt` within the offsets of a real zone (migration 20261201000000_committees).
model Committee {
  id                        String   @id @default(uuid())
  workspaceId               String   @map("workspace_id")
  name                      String
  localStart                DateTime @map("local_start") @db.Timestamp(0)
  timeZone                  String   @map("time_zone")
  startsAt                  DateTime @map("starts_at")
  location                  String?
  meetingUrl                String?  @map("meeting_url")
  status                    String   @default("planned")
  internalNotes             String?  @map("internal_notes")
  // E08.02: what the committee's candidates and investors read, beside the internal notes.
  sharedInfo                String?  @map("shared_info")
  // E08.04: offered on the workspace's public participation form (planned and not started only).
  participationRequestsOpen Boolean  @default(false) @map("participation_requests_open")
  version                   Int      @default(1)
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  workspace             Workspace                       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // E08.03: the requests applied to, proposed for or presented at it.
  applications          CommitteeApplication[]
  // E08.04: the participation requests asking for it.
  participationRequests ParticipationRequestCommittee[]
  // E08.06/E10.03: who was told of its changes of date, cancellation or restoration.
  notifications         Notification[]

  // Target of the composite foreign keys that keep what joins a committee (E08.03) inside its
  // workspace.
  @@unique([id, workspaceId])
  @@index([workspaceId, startsAt])
  @@map("committees")
}

// E08.03: a request's entry on a committee, through its candidature to the committee's workspace —
// both composite foreign keys carry `workspace_id`, so an entry never joins a committee and a
// candidature of different workspaces. At most one per candidature and committee; never deleted but
// with them, its version only grows. Rules: @confluent/shared `committee-application.schema.ts`.
model CommitteeApplication {
  id              String   @id @default(uuid())
  committeeId     String   @map("committee_id")
  candidatureId   String   @map("candidature_id")
  workspaceId     String   @map("workspace_id")
  // COMMITTEE_APPLICATION_STATUSES, changed only through `CommitteeApplicationsService`.
  status          String
  // Which side made the last change (`owner` or `workspace`), who, and when.
  statusBy        String   @map("status_by")
  statusActorId   String?  @map("status_actor_id")
  statusChangedAt DateTime @map("status_changed_at")
  version         Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  committee     Committee      @relation(fields: [committeeId, workspaceId], references: [id, workspaceId], onDelete: Cascade, onUpdate: NoAction)
  candidature   Candidature    @relation(fields: [candidatureId, workspaceId], references: [id, workspaceId], onDelete: Cascade, onUpdate: NoAction)
  statusActor   User?          @relation(fields: [statusActorId], references: [id], onDelete: SetNull)
  // E08.06/E10.03: the notifications its request's owner was sent about the committee.
  notifications Notification[]

  @@unique([committeeId, candidatureId])
  @@index([committeeId, workspaceId])
  @@index([candidatureId, workspaceId])
  @@index([statusActorId])
  @@map("committee_applications")
}

// E08.04: a request, sent from a workspace's public form by someone outside it (no account), to take
// part in some of its committees — pending, granting nothing, until a manager accepts it (E08.05:
// the address's account and membership are then created or reused) or refuses it. At most one
// pending request per address and workspace (partial unique index
// `participation_requests_pending_email_key`, in the migration only): a new submission adds its
// sessions to it and keeps what it said first. Rules: @confluent/shared
// `participation-request.schema.ts`.
model ParticipationRequest {
  id                String    @id @default(uuid())
  workspaceId       String    @map("workspace_id")
  // Lower case, as typed otherwise; not known to be the sender's until they act on an invitation.
  email             String
  name              String
  organization      String?
  message           String?
  // PARTICIPATION_REQUEST_STATUSES: `pending`, then `accepted` or `refused` (E08.05, final).
  status            String    @default("pending")
  submissionCount   Int       @default(1) @map("submission_count")
  lastSubmittedAt   DateTime  @map("last_submitted_at")
  version           Int       @default(1)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  // E08.05 — the decision: when and by whom (null once that account is gone).
  decidedAt         DateTime? @map("decided_at")
  decidedById       String?   @map("decided_by_id")
  // Accepted only: PARTICIPATION_ADMISSIONS — what the acceptance did to the address's account and
  // membership — and the account admitted (null once that account is gone).
  admission         String?
  memberUserId      String?   @map("member_user_id")
  // Accepted only: PARTICIPATION_INVITATION_EMAIL_STATUSES, and when it last changed.
  invitationEmail   String?   @map("invitation_email")
  invitationEmailAt DateTime? @map("invitation_email_at")

  workspace     Workspace                       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  committees    ParticipationRequestCommittee[]
  decidedBy     User?                           @relation("ParticipationDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  member        User?                           @relation("ParticipationMember", fields: [memberUserId], references: [id], onDelete: SetNull)
  // E08.06/E10.03: the notifications the accepted participant was sent about its sessions.
  notifications Notification[]

  // Target of the composite foreign key that keeps its sessions inside its workspace.
  @@unique([id, workspaceId])
  @@index([workspaceId, createdAt])
  @@index([decidedById])
  @@index([memberUserId])
  @@map("participation_requests")
}

// E08.04: a session a participation request asks for — a committee of the request's workspace (both
// composite foreign keys carry `workspace_id`).
model ParticipationRequestCommittee {
  requestId   String   @map("request_id")
  committeeId String   @map("committee_id")
  workspaceId String   @map("workspace_id")
  createdAt   DateTime @default(now()) @map("created_at")

  request   ParticipationRequest @relation(fields: [requestId, workspaceId], references: [id, workspaceId], onDelete: Cascade, onUpdate: NoAction)
  committee Committee            @relation(fields: [committeeId, workspaceId], references: [id, workspaceId], onDelete: Cascade, onUpdate: NoAction)

  @@id([requestId, committeeId])
  @@index([committeeId, workspaceId])
  @@map("participation_request_committees")
}

// E10.03: one person told of one event (`kind`, NOTIFICATION_KINDS) — rules in @confluent/shared
// `notification.schema.ts`. Written in the event's transaction; never twice for the same event and
// person (`dedupKey`: the event, its object and, when it has one, its version — unique per recipient).
// `subjectKey`: the object it is about, whose later notification supersedes an email still unsent.
// `payload`: what the text is written from, only the fields of the kind's allowlist
// (notifications/notification-payloads.ts), all readable by the recipient when it was written.
// `emailState` (NOTIFICATION_EMAIL_STATES): `none` for an in-app-only kind; otherwise `to_send` in the
// event's transaction, `sending` once a sender claimed it, then `sent` or `failed`; `superseded` when
// a later one about the same object reaches the same person before it left. The objects it hangs on
// remove it with them (a request, a workspace, a committee and, for a committee's change — E08.06,
// whose `committee_notices` it replaces —, the entry or participation request the person is told
// for, at the committee's version that change produced). CHECK: migration
// 20261213000000_notifications.
model Notification {
  id                     String    @id @default(uuid())
  recipientId            String    @map("recipient_id")
  kind                   String
  dedupKey               String    @map("dedup_key")
  subjectKey             String    @map("subject_key")
  workspaceId            String?   @map("workspace_id")
  dossierId              String?   @map("dossier_id")
  committeeId            String?   @map("committee_id")
  committeeVersion       Int?      @map("committee_version")
  applicationId          String?   @map("application_id")
  participationRequestId String?   @map("participation_request_id")
  payload                Json
  readAt                 DateTime? @map("read_at")
  emailState             String    @map("email_state")
  emailStateAt           DateTime  @map("email_state_at")
  createdAt              DateTime  @default(now()) @map("created_at")

  recipient            User                  @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  workspace            Workspace?            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dossier              Dossier?              @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  committee            Committee?            @relation(fields: [committeeId, workspaceId], references: [id, workspaceId], onDelete: Cascade, onUpdate: NoAction)
  application          CommitteeApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  participationRequest ParticipationRequest? @relation(fields: [participationRequestId], references: [id], onDelete: Cascade)

  // E10.08: the bell's unread count (read every minute by every open page) uses the partial index
  // `notifications_unread_recipient_id_idx` (`WHERE read_at IS NULL`, in the migration only: Prisma
  // cannot express it), whose size is the unread notifications, never the history.
  @@unique([recipientId, dedupKey])
  @@index([recipientId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([committeeId, workspaceId])
  @@index([workspaceId])
  @@index([dossierId])
  @@index([applicationId])
  @@index([participationRequestId])
  @@map("notifications")
}

// ROADMAP E09.05: an entrepreneur without an account asks a workspace, from its public page, for
// access to its candidature path — rules in @confluent/shared `entrepreneur-access-request.schema.ts`.
// `pending` until its managers decide it, once: `accepted` (the address's account created as an
// entrepreneur's, or an existing one kept as it is: `admission`, `accountUserId`; then an invitation
// email, `invitationEmail`) or `refused` (nothing created). It grants nothing before. At most one
// pending request per address and workspace (partial unique index of the migration). CHECK: closed
// values, bounded one-line texts, plain message, each status tied to its decision columns
// (migration 20261211000000_entrepreneur_access_requests).
model EntrepreneurAccessRequest {
  id                String    @id @default(uuid())
  workspaceId       String    @map("workspace_id")
  // Lower case; not known to be the sender's until they act on an invitation.
  email             String
  name              String
  companyName       String    @map("company_name")
  message           String?
  status            String    @default("pending")
  submissionCount   Int       @default(1) @map("submission_count")
  lastSubmittedAt   DateTime  @map("last_submitted_at")
  version           Int       @default(1)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  decidedAt         DateTime? @map("decided_at")
  decidedById       String?   @map("decided_by_id")
  admission         String?
  accountUserId     String?   @map("account_user_id")
  invitationEmail   String?   @map("invitation_email")
  invitationEmailAt DateTime? @map("invitation_email_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  decidedBy User?     @relation("EntrepreneurAccessDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  account   User?     @relation("EntrepreneurAccessAccount", fields: [accountUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([decidedById])
  @@index([accountUserId])
  @@map("entrepreneur_access_requests")
}

// ROADMAP E10.10: a person's request to delete their account, then an administrator's decision —
// rules in @confluent/shared `privacy.schema.ts`. `pending` (at most one per account: partial unique
// index of the migration) → `completed` (the account deleted: `user_id` is then null, which a CHECK
// holds; `summary` counts what was deleted, `confirmation_email` whether the email to the former
// address left) | `declined` (with the note the person reads) | `cancelled` (withdrawn by the
// person). `subject_ref`: the pseudonym that names it once the account is gone. CHECK: closed values,
// each status tied to its decision columns, bounded note (migration 20261215000000_privacy).
model AccountDeletionRequest {
  id                String    @id @default(uuid())
  userId            String?   @map("user_id")
  subjectRef        String    @map("subject_ref")
  status            String    @default("pending")
  requestedAt       DateTime  @default(now()) @map("requested_at")
  decidedAt         DateTime? @map("decided_at")
  decidedById       String?   @map("decided_by_id")
  declineNote       String?   @map("decline_note")
  summary           Json?
  confirmationEmail String?   @map("confirmation_email")

  user      User? @relation("DeletionRequester", fields: [userId], references: [id], onDelete: SetNull)
  decidedBy User? @relation("DeletionDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status, requestedAt])
  @@index([decidedById])
  @@map("account_deletion_requests")
}

// ROADMAP E10.10: a stored file whose last document row was deleted (a request, a company or an
// account deleted), to remove from the storage. Filled by the trigger `documents_storage_cleanup`
// (migration 20261215000000_privacy) in the deleting transaction — whatever deleted the rows —, and
// emptied by the retention job after the commit: the object is deleted only if no document row
// refers to its key any more, then the row goes; a failure is counted and retried at the next run.
model StorageDeletion {
  storageKey    String    @id @map("storage_key")
  requestedAt   DateTime  @default(now()) @map("requested_at")
  attempts      Int       @default(0)
  lastAttemptAt DateTime? @map("last_attempt_at")
  lastError     String?   @map("last_error")

  @@index([requestedAt])
  @@map("storage_deletions")
}
