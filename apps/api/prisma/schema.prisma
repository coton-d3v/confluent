generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum user_role {
  entrepreneur
  financeur
  admin

  @@map("user_role")
}

enum share_link_status {
  pending
  active
  revoked
  expired

  @@map("share_link_status")
}

enum field_type {
  text
  textarea
  email
  number
  date
  select
  checkbox
  file

  @@map("field_type")
}

enum audit_action {
  magic_link_requested
  magic_link_consumed
  share_link_created
  share_link_viewed
  share_link_revoked
  dossier_created
  dossier_updated
  dossier_classified
  questionnaire_version_published
  user_deactivated
  user_reactivated
  rate_limit_exceeded
  share_link_access_denied
  share_link_access_requested
  admin_edited_field
  admin_uploaded_document
  admin_revoked_share_link
  session_revoked
  refresh_token_reused
  oauth_grant_created
  oauth_grant_revoked
  oauth_refresh_token_reused
  mcp_tool_called

  @@map("audit_action")
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  role            user_role
  isActive        Boolean   @default(true) @map("is_active")
  emailVerifiedAt DateTime? @map("email_verified_at")
  locale          String    @default("fr")
  firstName       String?   @map("first_name")
  lastName        String?   @map("last_name")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  dossiers         Dossier[]
  magicLinkTokens  MagicLinkToken[]
  refreshSessions  RefreshSession[]
  oauthGrants      OAuthGrant[]
  auditLogsAsActor AuditLog[]       @relation("AuditLogActor")

  @@map("users")
}

// One row per issued refresh token (its JWT `jti`). Rotation revokes the presented row and links it
// to its successor; all rows of a login share a `familyId`, so presenting an already-rotated token
// (theft/replay) revokes the whole family.
model RefreshSession {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  familyId     String    @map("family_id")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_sessions")
}

model MagicLinkToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  token      String    @unique
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("magic_link_tokens")
}

// A form definition (ROADMAP E03.01). `usage` says what its answers describe; today only `dossier`
// (the company profile filled in each dossier). Workspace-specific forms arrive with E05.
model Questionnaire {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  usage     String
  createdAt DateTime @default(now()) @map("created_at")

  versions QuestionnaireVersion[]

  @@map("questionnaires")
}

// One version of a form. `status`: draft (editable, unused) → published (exactly one per form, used for
// new dossiers, immutable) → archived (kept for the dossiers created with it). See E03.02/E03.08.
model QuestionnaireVersion {
  id              String    @id @default(uuid())
  questionnaireId String    @map("questionnaire_id")
  version         Int
  status          String    @default("draft")
  publishedAt     DateTime? @map("published_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  questionnaire Questionnaire          @relation(fields: [questionnaireId], references: [id])
  sections      QuestionnaireSection[]
  fields        QuestionnaireField[]
  dossiers      Dossier[]

  @@unique([questionnaireId, version])
  @@index([questionnaireId, status])
  @@map("questionnaire_versions")
}

// Ordered section of a version; `key` is stable across versions (E03.03, E03.06).
model QuestionnaireSection {
  id         String @id @default(uuid())
  versionId  String @map("version_id")
  key        String
  title      String
  orderIndex Int    @map("order_index")

  version QuestionnaireVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  fields  QuestionnaireField[]

  @@unique([versionId, key])
  @@map("questionnaire_sections")
}

model QuestionnaireField {
  id             String     @id @default(uuid())
  versionId      String     @map("version_id")
  sectionId      String     @map("section_id")
  // Stable technical identifier (E03.06): classification and integrations read it; labels may change.
  key            String
  label          String
  helpText       String?    @map("help_text")
  fieldType      field_type @map("field_type")
  // Choices of a `select` field (E03.06): [{ "key": "seed", "label": "Seed – investisseurs" }].
  // Answers store the choice key, so renaming a label never changes how an answer is read.
  choices        Json       @default("[]")
  required       Boolean    @default(false)
  orderIndex     Int        @map("order_index")
  // Type-specific limits (E03.05), e.g. { "maxLength": 500 } or { "min": 0, "max": 100 }.
  constraints    Json       @default("{}")
  // Lowest share access level (public < partiel < complet) that may read this field's answers.
  // Defaults to the most restrictive level: a field nobody classified stays hidden from financeurs.
  minAccessLevel String     @default("complet") @map("min_access_level")

  version QuestionnaireVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  section QuestionnaireSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  answers DossierAnswer[]

  @@unique([versionId, key])
  @@index([versionId, orderIndex])
  @@map("questionnaire_fields")
}

model Dossier {
  id                     String    @id @default(uuid())
  userId                 String    @map("user_id")
  name                   String
  slug                   String    @unique
  questionnaireVersionId String    @map("questionnaire_version_id")
  sector                 String?
  maturityStage          String?   @map("maturity_stage")
  ancrageCvl             String?   @map("ancrage_cvl")
  tagTechnologique       String?   @map("tag_technologique")
  axe1Projet             Int?      @map("axe1_projet")
  axe2Financier          Int?      @map("axe2_financier")
  axe3Origine            Int?      @map("axe3_origine")
  deeptechScore          Int?      @map("deeptech_score")
  preCreation            Boolean?  @map("pre_creation")
  submittedAt            DateTime? @map("submitted_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionnaireVersion QuestionnaireVersion @relation(fields: [questionnaireVersionId], references: [id])
  answers              DossierAnswer[]
  shareLinks           ShareLink[]
  documents            Document[]
  auditLogs            AuditLog[]

  @@index([userId])
  @@index([slug])
  @@map("dossiers")
}

model Document {
  id         String   @id @default(uuid())
  dossierId  String   @map("dossier_id")
  filename   String
  mimetype   String
  storageKey String   @map("storage_key")
  size       Int
  version    Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at")

  dossier Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@unique([dossierId, filename, version])
  @@index([dossierId])
  @@map("documents")
}

model DossierAnswer {
  id        String   @id @default(uuid())
  dossierId String   @map("dossier_id")
  fieldId   String   @map("field_id")
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  dossier Dossier            @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  field   QuestionnaireField @relation(fields: [fieldId], references: [id])

  @@unique([dossierId, fieldId])
  @@map("dossier_answers")
}

model ShareLink {
  id             String            @id @default(uuid())
  dossierId      String            @map("dossier_id")
  recipientEmail String            @map("recipient_email")
  token          String            @unique
  status         share_link_status @default(pending)
  accessLevel    String            @default("complet") @map("access_level")
  createdAt      DateTime          @default(now()) @map("created_at")
  revokedAt      DateTime?         @map("revoked_at")

  dossier   Dossier    @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  auditLogs AuditLog[]

  @@index([dossierId])
  @@index([token])
  @@map("share_links")
}

model AuditLog {
  id          String       @id @default(uuid())
  dossierId   String?      @map("dossier_id")
  actorId     String?      @map("actor_id")
  shareLinkId String?      @map("share_link_id")
  actionType  audit_action @map("action_type")
  metadata    Json         @default("{}")
  createdAt   DateTime     @default(now()) @map("created_at")

  dossier   Dossier?   @relation(fields: [dossierId], references: [id], onDelete: SetNull)
  actor     User?      @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  shareLink ShareLink? @relation(fields: [shareLinkId], references: [id], onDelete: SetNull)

  @@index([dossierId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_log")
}

// ── OAuth 2.1 authorization server for MCP clients (Claude, ChatGPT…) — roadmap E01.03 ──────────

// A client application. `source`: `dcr` (RFC 7591 registration) or `cimd` (client_id is an HTTPS URL
// whose metadata document was fetched). `clientSecret` is only set for confidential DCR clients: the
// MCP SDK compares it verbatim, so it cannot be hashed.
model OAuthClient {
  id                      String    @id
  source                  String
  name                    String
  redirectUris            String[]  @map("redirect_uris")
  tokenEndpointAuthMethod String    @default("none") @map("token_endpoint_auth_method")
  clientSecret            String?   @map("client_secret")
  metadata                Json
  fetchedAt               DateTime? @map("fetched_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  authorizationRequests OAuthAuthorizationRequest[]
  grants                OAuthGrant[]

  @@map("oauth_clients")
}

// An /authorize request waiting for the user's consent in the web app (short-lived).
model OAuthAuthorizationRequest {
  id            String    @id @default(uuid())
  clientId      String    @map("client_id")
  redirectUri   String    @map("redirect_uri")
  scopes        String[]
  codeChallenge String    @map("code_challenge")
  state         String?
  resource      String
  expiresAt     DateTime  @map("expires_at")
  decidedAt     DateTime? @map("decided_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("oauth_authorization_requests")
}

// A user's consent to one client = one "connected application". Revoking it kills every token.
model OAuthGrant {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  clientId   String    @map("client_id")
  scopes     String[]
  resource   String
  expiresAt  DateTime  @map("expires_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  client OAuthClient  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tokens OAuthToken[]

  @@index([userId])
  @@map("oauth_grants")
}

// Authorization codes, access and refresh tokens of a grant. Only the SHA-256 of the opaque value
// is stored. `codeChallenge`/`redirectUri` are set for codes only.
model OAuthToken {
  id            String    @id @default(uuid())
  grantId       String    @map("grant_id")
  kind          String
  tokenHash     String    @unique @map("token_hash")
  // Scopes this token carries (a refresh may narrow them; never widen).
  scopes        String[]  @default([])
  codeChallenge String?   @map("code_challenge")
  redirectUri   String?   @map("redirect_uri")
  expiresAt     DateTime  @map("expires_at")
  usedAt        DateTime? @map("used_at")
  revokedAt     DateTime? @map("revoked_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  grant OAuthGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([grantId])
  @@map("oauth_tokens")
}
