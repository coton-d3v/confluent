generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum user_role {
  entrepreneur
  financeur
  admin

  @@map("user_role")
}

enum share_link_status {
  pending
  active
  revoked
  expired

  @@map("share_link_status")
}

enum field_type {
  text
  textarea
  email
  number
  date
  select
  checkbox
  file

  @@map("field_type")
}

enum audit_action {
  magic_link_requested
  magic_link_consumed
  share_link_created
  share_link_viewed
  share_link_revoked
  dossier_created
  dossier_updated
  dossier_classified
  questionnaire_version_published
  user_deactivated
  user_reactivated
  rate_limit_exceeded
  share_link_access_denied
  share_link_access_requested
  admin_edited_field
  admin_uploaded_document
  admin_revoked_share_link
  session_revoked
  refresh_token_reused
  oauth_grant_created
  oauth_grant_revoked
  oauth_refresh_token_reused
  mcp_tool_called
  form_created
  form_updated
  form_draft_created
  form_draft_discarded
  classification_rules_updated
  dossier_submitted
  workspace_created
  workspace_updated
  workspace_member_invited
  workspace_member_updated
  workspace_member_deactivated
  workspace_member_reactivated
  document_type_changed
  document_version_restored
  dossier_published
  dossier_unpublished
  dossier_document_selected
  dossier_document_unselected
  company_prepared
  company_transfer_invited
  company_transfer_accepted
  company_transfer_declined
  company_transfer_cancelled

  @@map("audit_action")
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  role            user_role
  isActive        Boolean   @default(true) @map("is_active")
  emailVerifiedAt DateTime? @map("email_verified_at")
  locale          String    @default("fr")
  firstName       String?   @map("first_name")
  lastName        String?   @map("last_name")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  companies        Company[]
  dossiers         Dossier[]
  magicLinkTokens  MagicLinkToken[]
  refreshSessions  RefreshSession[]
  oauthGrants      OAuthGrant[]
  auditLogsAsActor AuditLog[]              @relation("AuditLogActor")
  answersWritten   DossierAnswer[]
  revisionsWritten DossierAnswerRevision[]
  memberships      WorkspaceMembership[]   @relation("WorkspaceMember")
  membersInvited   WorkspaceMembership[]   @relation("WorkspaceMemberInviter")
  transfersOffered CompanyTransfer[]       @relation("CompanyTransferFrom")
  transfersToMe    CompanyTransfer[]       @relation("CompanyTransferTo")

  @@map("users")
}

// One row per issued refresh token (its JWT `jti`). Rotation revokes the presented row and links it
// to its successor; all rows of a login share a `familyId`, so presenting an already-rotated token
// (theft/replay) revokes the whole family.
model RefreshSession {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  familyId     String    @map("family_id")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_sessions")
}

model MagicLinkToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  token      String    @unique
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("magic_link_tokens")
}

// A form definition (ROADMAP E03.01). `usage` says what its answers describe; today only `dossier`
// (the company profile filled in each dossier). Workspace-specific forms arrive with E05.
model Questionnaire {
  id         String    @id @default(uuid())
  slug       String    @unique
  name       String
  // Business usage the form is assigned to (E03.09), null when unassigned; one form per usage.
  usage      String?   @unique
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  versions QuestionnaireVersion[]

  @@map("questionnaires")
}

// One version of a form. `status`: draft (editable, unused) → published (exactly one per form, used for
// new dossiers, immutable) → archived (kept for the dossiers created with it). See E03.02/E03.08.
model QuestionnaireVersion {
  id              String    @id @default(uuid())
  questionnaireId String    @map("questionnaire_id")
  version         Int
  // At most one draft and one published version per form (partial unique indexes, migration
  // 20261109030000_form_builder): only the draft is editable.
  status          String    @default("draft")
  publishedAt     DateTime? @map("published_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  questionnaire Questionnaire          @relation(fields: [questionnaireId], references: [id])
  sections      QuestionnaireSection[]
  fields        QuestionnaireField[]
  dossiers      Dossier[]
  companies     Company[]

  @@unique([questionnaireId, version])
  @@index([questionnaireId, status])
  @@map("questionnaire_versions")
}

// Ordered section of a version; `key` is stable across versions (E03.03, E03.06).
model QuestionnaireSection {
  id         String @id @default(uuid())
  versionId  String @map("version_id")
  key        String
  title      String
  orderIndex Int    @map("order_index")

  version QuestionnaireVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  fields  QuestionnaireField[]

  @@unique([versionId, key])
  @@map("questionnaire_sections")
}

model QuestionnaireField {
  id             String     @id @default(uuid())
  versionId      String     @map("version_id")
  sectionId      String     @map("section_id")
  // Stable technical identifier (E03.06): classification and integrations read it; labels may change.
  key            String
  label          String
  helpText       String?    @map("help_text")
  fieldType      field_type @map("field_type")
  // Choices of a `select` field (E03.06): [{ "key": "seed", "label": "Seed – investisseurs" }].
  // Answers store the choice key, so renaming a label never changes how an answer is read.
  choices        Json       @default("[]")
  required       Boolean    @default(false)
  orderIndex     Int        @map("order_index")
  // Type-specific limits (E03.05), e.g. { "maxLength": 500 } or { "min": 0, "max": 100 }.
  constraints    Json       @default("{}")
  // Lowest share access level (public < partiel < complet) that may read this field's answers.
  // Defaults to the most restrictive level: a field nobody classified stays hidden from financeurs.
  minAccessLevel String     @default("complet") @map("min_access_level")

  version   QuestionnaireVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  section   QuestionnaireSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  answers   DossierAnswer[]
  documents LibraryDocument[]

  @@unique([versionId, key])
  @@index([versionId, orderIndex])
  @@map("questionnaire_fields")
}

// The company an entrepreneur presents (ROADMAP E05.04): owner of the common profile (D01) and,
// from E05.06, of the document library; its financing dossiers are `dossiers`. It belongs to no
// workspace (it applies to several). Since E05.05 the profile is the company's: the form version it
// answers (`profileVersionId`), its answers and their history, its documents. Name format: CHECK
// constraint (migration 20261112000000_companies).
//
// E05.08: a conseiller may prepare a company for an entrepreneur. While `preparedInWorkspaceId` is
// set, its owner is that conseiller, who holds it for the workspace and reaches it only while an
// active conseiller there; the entrepreneur becomes its owner by accepting a transfer (`transfers`),
// which changes `ownerId` — the dossiers follow by their composite foreign key — and clears
// `preparedInWorkspaceId`. A prepared company is neither shared nor published.
model Company {
  id                    String   @id @default(uuid())
  ownerId               String   @map("owner_id")
  name                  String
  // The version of the company-profile form its answers belong to, kept until an explicit
  // migration of the answers (E03.08). Its dossiers carry a copy the database keeps equal.
  profileVersionId      String   @map("profile_version_id")
  preparedInWorkspaceId String?  @map("prepared_in_workspace_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  owner               User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  profileVersion      QuestionnaireVersion @relation(fields: [profileVersionId], references: [id])
  preparedInWorkspace Workspace?           @relation(fields: [preparedInWorkspaceId], references: [id], onDelete: Restrict)
  transfers           CompanyTransfer[]
  dossiers            Dossier[]            @relation("CompanyDossiers")
  profileDossiers     Dossier[]            @relation("CompanyProfileDossiers")
  answers             DossierAnswer[]
  library             LibraryDocument[]
  documents           Document[]

  // Targets of the dossiers' (company, owner) and (company, profile version) foreign keys.
  @@unique([id, ownerId])
  @@unique([id, profileVersionId])
  @@index([ownerId])
  @@index([profileVersionId])
  @@index([preparedInWorkspaceId])
  @@map("companies")
}

// A transfer of a company's ownership offered to an entrepreneur (ROADMAP E05.08), by the conseiller
// who prepared it in a workspace: the invitation and, once decided, the trace of who gave the company
// to whom, from which workspace and when. `toEmail` is the address the conseiller typed, `toUserId`
// the account behind it (created if unknown). `status`: `pending` (at most one per company) →
// `accepted` | `declined`, or `cancelled` (withdrawn or replaced by the conseiller) | `expired`
// (replaced after `expiresAt`); a pending one past `expiresAt` can no longer be decided. Closed
// values and formats: CHECK constraints (migration 20261114000000_company_transfers).
model CompanyTransfer {
  id          String    @id @default(uuid())
  companyId   String    @map("company_id")
  workspaceId String    @map("workspace_id")
  // Null once that account is deleted; the journal keeps who it was.
  fromUserId  String?   @map("from_user_id")
  toUserId    String    @map("to_user_id")
  toEmail     String    @map("to_email")
  status      String    @default("pending")
  expiresAt   DateTime  @map("expires_at")
  decidedAt   DateTime? @map("decided_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  fromUser  User?     @relation("CompanyTransferFrom", fields: [fromUserId], references: [id], onDelete: SetNull)
  toUser    User      @relation("CompanyTransferTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([workspaceId])
  @@index([fromUserId])
  @@index([toUserId])
  @@map("company_transfers")
}

// A financing dossier of a company (ROADMAP E05.04): one precise financing request (E05.07), several
// per company. It presents its company's profile (answers, E05.05) and the documents of the library
// it selects (`documentSelection`); it keeps its own title (`name`), slug, presentation, publication,
// submission, classification, shares and journal. Formats and closed values: CHECK constraints
// (migration 20261113000000_financing_requests).
model Dossier {
  id                     String    @id @default(uuid())
  // The owner of the company, never set on its own: the (company_id, user_id) foreign key keeps it
  // equal to `companies.owner_id`, and a change of owner (E05.08) cascades to it.
  userId                 String    @map("user_id")
  companyId              String    @map("company_id")
  name                   String
  slug                   String    @unique
  // The company's profile version, never set on its own: the (company_id, questionnaire_version_id)
  // foreign key keeps it equal to `companies.profile_version_id` (E05.05).
  questionnaireVersionId String    @map("questionnaire_version_id")
  sector                 String?
  maturityStage          String?   @map("maturity_stage")
  ancrageCvl             String?   @map("ancrage_cvl")
  tagTechnologique       String?   @map("tag_technologique")
  axe1Projet             Int?      @map("axe1_projet")
  axe2Financier          Int?      @map("axe2_financier")
  axe3Origine            Int?      @map("axe3_origine")
  deeptechScore          Int?      @map("deeptech_score")
  preCreation            Boolean?  @map("pre_creation")
  // Field keys each classification column was computed from, recorded with the values (code
  // review R31): what a share may see is judged on them, not on the rules as they are now.
  classificationSources  Json?     @map("classification_sources")
  submittedAt            DateTime? @map("submitted_at")
  // The request's presentation (E05.07), plain text never rendered as HTML; shown to the recipients
  // of the dossier's shares once it is published.
  summary                String?
  objective              String?
  description            String?
  // Whole euros.
  amountEur              Int?      @map("amount_eur")
  // FINANCING_TYPES of @confluent/shared, without duplicates.
  financingTypes         String[]  @default([]) @map("financing_types")
  // `draft` | `published`; `publishedAt` is set exactly while published.
  publicationStatus      String    @default("draft") @map("publication_status")
  publishedAt            DateTime? @map("published_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  // NoAction: a company keeps its dossiers (checked at the end of the statement, so deleting an
  // account still removes both).
  company              Company              @relation("CompanyDossiers", fields: [companyId, userId], references: [id, ownerId], onDelete: NoAction, onUpdate: Cascade)
  companyProfile       Company              @relation("CompanyProfileDossiers", fields: [companyId, questionnaireVersionId], references: [id, profileVersionId], onDelete: NoAction, onUpdate: Cascade)
  questionnaireVersion QuestionnaireVersion @relation(fields: [questionnaireVersionId], references: [id])
  shareLinks           ShareLink[]
  auditLogs            AuditLog[]
  documentSelection    DossierDocument[]

  // Target of the selection's (dossier, company) foreign key.
  @@unique([id, companyId])
  @@index([userId])
  @@index([companyId])
  @@index([slug])
  @@map("dossiers")
}

// A document of the company's library (ROADMAP E05.06): a file name, answering one attachment
// field of the company-profile form or none (code review R48), with a type and its successive
// versions (`documents`). A file deposited under the same name for the same field is a new version
// of it. Unique per (company, field, name) — the index cannot hold for a NULL field, so documents
// are created under the profile's lock. Type: CHECK constraint `library_documents_type_check`
// (DOCUMENT_TYPES in @confluent/shared).
model LibraryDocument {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  fieldId   String?  @map("field_id")
  filename  String
  type      String   @default("other")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company    Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // The field's read level applies to every version (E03.11).
  field      QuestionnaireField? @relation(fields: [fieldId], references: [id], onDelete: SetNull)
  versions   Document[]
  selections DossierDocument[]

  @@unique([companyId, fieldId, filename])
  // Target of the versions' (document, company, name) foreign key.
  @@unique([id, companyId, filename])
  // Target of the selections' (document, company) foreign key.
  @@unique([id, companyId])
  @@index([fieldId])
  @@map("library_documents")
}

// One version of a library document (E05.06; before, each row was a version identified by its
// company, field and name). Versions are never changed nor deleted by the application: bringing an
// earlier version back adds a new version pointing at the same stored object (`restoredFromId`), so
// a stored object may be shared by several versions and must not be deleted while one refers to it.
// `companyId` and `filename` are copies of the document's, kept equal by the composite foreign key.
model Document {
  id                String   @id @default(uuid())
  libraryDocumentId String   @map("library_document_id")
  companyId         String   @map("company_id")
  filename          String
  mimetype          String
  storageKey        String   @map("storage_key")
  size              Int
  version           Int      @default(1)
  // The earlier version of the same document this one brought back, null for a deposit.
  restoredFromId    String?  @map("restored_from_id")
  createdAt         DateTime @default(now()) @map("created_at")

  libraryDocument  LibraryDocument         @relation(fields: [libraryDocumentId, companyId, filename], references: [id, companyId, filename], onDelete: Cascade, onUpdate: Cascade)
  company          Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  restoredFrom     Document?               @relation("DocumentRestorations", fields: [restoredFromId], references: [id], onDelete: SetNull)
  restorations     Document[]              @relation("DocumentRestorations")
  citedBy          DossierAnswer[]
  citedByRevisions DossierAnswerRevision[]
  pinnedBy         DossierDocument[]

  @@unique([libraryDocumentId, version])
  // Target of the selections' (pinned version, document) foreign key.
  @@unique([id, libraryDocumentId])
  @@index([companyId])
  @@index([restoredFromId])
  @@map("documents")
}

// A document of the company's library selected by one of its dossiers (ROADMAP E05.07): following
// its latest version (`pinnedVersionId` null) or pinned to one of its versions. Only selected
// documents, at that version, reach the recipients of the dossier's shares; the owner keeps the whole
// library. Composite foreign keys hold the dossier, the document and the pinned version in the same
// company and document.
model DossierDocument {
  id                String   @id @default(uuid())
  dossierId         String   @map("dossier_id")
  companyId         String   @map("company_id")
  libraryDocumentId String   @map("library_document_id")
  pinnedVersionId   String?  @map("pinned_version_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  dossier         Dossier         @relation(fields: [dossierId, companyId], references: [id, companyId], onDelete: Cascade, onUpdate: Cascade)
  libraryDocument LibraryDocument @relation(fields: [libraryDocumentId, companyId], references: [id, companyId], onDelete: Cascade, onUpdate: Cascade)
  pinnedVersion   Document?       @relation(fields: [pinnedVersionId, libraryDocumentId], references: [id, libraryDocumentId], onDelete: Cascade, onUpdate: Cascade)

  @@unique([dossierId, libraryDocumentId])
  @@index([libraryDocumentId])
  @@index([pinnedVersionId])
  @@map("dossier_documents")
}

// An answer of a company's profile (E05.05: moved from the dossier to its company, same rows, same
// ids), read through any of its dossiers.
model DossierAnswer {
  id               String   @id @default(uuid())
  companyId        String   @map("company_id")
  fieldId          String   @map("field_id")
  value            String
  // Provenance of the current value (E04.04), rewritten with it; all null for an answer saved
  // before it was recorded. `updatedAt` is its date. Closed values: see the CHECK constraints.
  origin           String? // human | ai
  confirmation     String? // confirmed | pending
  channel          String? // site | admin | mcp
  authorId         String?  @map("author_id")
  clientName       String?  @map("client_name")
  // Document version the value was taken from, and where Confluent found the cited excerpt.
  sourceDocumentId String?  @map("source_document_id")
  sourceLocation   String?  @map("source_location")
  sourceExcerpt    String?  @map("source_excerpt")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  company        Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  field          QuestionnaireField      @relation(fields: [fieldId], references: [id])
  author         User?                   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  sourceDocument Document?               @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  revisions      DossierAnswerRevision[]

  @@unique([companyId, fieldId])
  @@index([authorId])
  @@index([sourceDocumentId])
  @@map("dossier_answers")
}

// A state an answer held before it gave way (E04.05), kept when an AI assistant is involved: a
// proposal corrected, replaced or confirmed, or a value replaced by a proposal. Same provenance
// columns as `DossierAnswer`; `recordedAt` is when that state was written, `replacedAt` when it
// gave way. Closed values: see the CHECK constraints.
model DossierAnswerRevision {
  id               String   @id @default(uuid())
  answerId         String   @map("answer_id")
  value            String
  origin           String? // human | ai
  confirmation     String? // confirmed | pending
  channel          String? // site | admin | mcp
  authorId         String?  @map("author_id")
  clientName       String?  @map("client_name")
  sourceDocumentId String?  @map("source_document_id")
  sourceLocation   String?  @map("source_location")
  sourceExcerpt    String?  @map("source_excerpt")
  recordedAt       DateTime @map("recorded_at")
  replacedAt       DateTime @default(now()) @map("replaced_at")

  answer         DossierAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  author         User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  sourceDocument Document?     @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  @@index([answerId])
  @@index([authorId])
  @@index([sourceDocumentId])
  @@map("dossier_answer_revisions")
}

model ShareLink {
  id             String            @id @default(uuid())
  dossierId      String            @map("dossier_id")
  recipientEmail String            @map("recipient_email")
  token          String            @unique
  status         share_link_status @default(pending)
  accessLevel    String            @default("complet") @map("access_level")
  createdAt      DateTime          @default(now()) @map("created_at")
  revokedAt      DateTime?         @map("revoked_at")

  dossier   Dossier    @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  auditLogs AuditLog[]

  @@index([dossierId])
  @@index([token])
  @@map("share_links")
}

model AuditLog {
  id          String       @id @default(uuid())
  dossierId   String?      @map("dossier_id")
  actorId     String?      @map("actor_id")
  shareLinkId String?      @map("share_link_id")
  actionType  audit_action @map("action_type")
  metadata    Json         @default("{}")
  createdAt   DateTime     @default(now()) @map("created_at")

  dossier   Dossier?   @relation(fields: [dossierId], references: [id], onDelete: SetNull)
  actor     User?      @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  shareLink ShareLink? @relation(fields: [shareLinkId], references: [id], onDelete: SetNull)

  @@index([dossierId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_log")
}

// ── OAuth 2.1 authorization server for MCP clients (Claude, ChatGPT…) — roadmap E01.03 ──────────

// A client application. `source`: `dcr` (RFC 7591 registration) or `cimd` (client_id is an HTTPS URL
// whose metadata document was fetched). `clientSecret` is only set for confidential DCR clients: the
// MCP SDK compares it verbatim, so it cannot be hashed.
model OAuthClient {
  id                      String    @id
  source                  String
  name                    String
  redirectUris            String[]  @map("redirect_uris")
  tokenEndpointAuthMethod String    @default("none") @map("token_endpoint_auth_method")
  clientSecret            String?   @map("client_secret")
  metadata                Json
  fetchedAt               DateTime? @map("fetched_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  authorizationRequests OAuthAuthorizationRequest[]
  grants                OAuthGrant[]

  @@map("oauth_clients")
}

// An /authorize request waiting for the user's consent in the web app (short-lived).
model OAuthAuthorizationRequest {
  id            String    @id @default(uuid())
  clientId      String    @map("client_id")
  redirectUri   String    @map("redirect_uri")
  scopes        String[]
  codeChallenge String    @map("code_challenge")
  state         String?
  resource      String
  expiresAt     DateTime  @map("expires_at")
  decidedAt     DateTime? @map("decided_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("oauth_authorization_requests")
}

// A user's consent to one client = one "connected application". Revoking it kills every token.
model OAuthGrant {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  clientId   String    @map("client_id")
  scopes     String[]
  resource   String
  expiresAt  DateTime  @map("expires_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  client OAuthClient  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tokens OAuthToken[]

  @@index([userId])
  @@map("oauth_grants")
}

// Authorization codes, access and refresh tokens of a grant. Only the SHA-256 of the opaque value
// is stored. `codeChallenge`/`redirectUri` are set for codes only.
model OAuthToken {
  id            String    @id @default(uuid())
  grantId       String    @map("grant_id")
  kind          String
  tokenHash     String    @unique @map("token_hash")
  // Scopes this token carries (a refresh may narrow them; never widen).
  scopes        String[]  @default([])
  codeChallenge String?   @map("code_challenge")
  redirectUri   String?   @map("redirect_uri")
  expiresAt     DateTime  @map("expires_at")
  usedAt        DateTime? @map("used_at")
  revokedAt     DateTime? @map("revoked_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  grant OAuthGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([grantId])
  @@map("oauth_tokens")
}

// Classification rules (ROADMAP E03.12): which answer (field key, choice key) gives which value of
// a classification dimension. Dimensions and their values are defined in @confluent/shared.
model ClassificationRule {
  id        String   @id @default(uuid())
  dimension String
  fieldKey  String   @map("field_key")
  // '' when the rule reads the whole field (`label` dimensions).
  choiceKey String   @default("") @map("choice_key")
  value     String   @default("")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([dimension, fieldKey, choiceKey])
  @@map("classification_rules")
}

// The space of one structure (CCI, incubator, investor network, club deal) and its settings
// (ROADMAP E05.01). Memberships (E05.02) and isolation (E05.03) attach to it later. Formats and
// closed values are also enforced by CHECK constraints (migration 20261111300000_workspaces).
model Workspace {
  id           String   @id @default(uuid())
  // Public and stable (future `/w/<slug>` page): set at creation, never changed.
  slug         String   @unique
  name         String
  programName  String?  @map("program_name")
  // `#rrggbb`.
  color        String?
  // Plain text, never rendered as HTML or Markdown.
  presentation String?
  contactEmail String?  @map("contact_email")
  // Lower-case ASCII host name the workspace's invitations are restricted to (applied from E05.02).
  emailDomain  String?  @map("email_domain")
  // Opaque key of the logo in the private bucket (`workspaces/<id>/logo/<uuid>`), served by signed URL.
  logoKey      String?  @map("logo_key")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships       WorkspaceMembership[]
  preparedCompanies Company[]
  companyTransfers  CompanyTransfer[]

  @@map("workspaces")
}

// A person's place in one workspace (ROADMAP E05.02), distinct from the account's global role
// (`users.role`): the global role never grants a workspace right (administrators aside), and a
// membership never changes the global role. Deactivating keeps the row and its history; what it
// grants stops at the next request, since rights are read from this row at each one.
model WorkspaceMembership {
  id                 String    @id @default(uuid())
  workspaceId        String    @map("workspace_id")
  userId             String    @map("user_id")
  // `conseiller` | `investisseur` (CHECK).
  role               String
  organization       String?
  // Investisseurs only (CHECK): `business_angel` | `fonds_investissement` | `banque` |
  // `financeur_public` | `reseau_pret_honneur` | `autre`.
  investorType       String?   @map("investor_type")
  // Conseillers only (CHECK): sets up the workspace and manages its members.
  canManageWorkspace Boolean   @default(false) @map("can_manage_workspace")
  invitedById        String?   @map("invited_by_id")
  deactivatedAt      DateTime? @map("deactivated_at")
  // Date of the invitation.
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("WorkspaceMember", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("WorkspaceMemberInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_memberships")
}
