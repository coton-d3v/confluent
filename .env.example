# Prisma connection string for local postgres (Docker Compose service `postgres`).
DATABASE_URL=postgresql://confluent:confluent@localhost:5432/confluent

# NestJS HTTP port.
PORT=3000

# Runtime environment: development | test | production.
NODE_ENV=development

# Base URL of the web app — used in magic-link emails (Story 6.2) to build clickable URLs.
FRONTEND_URL=http://localhost:5173

# Public base URL of this API: OAuth issuer for MCP clients; the MCP endpoint is ${API_PUBLIC_URL}/mcp.
# Must be the exact HTTPS URL Claude/ChatGPT reach in production (e.g. https://api.confluent.network).
API_PUBLIC_URL=http://localhost:3000
# Extra browser origins allowed to call /mcp (comma-separated, optional).
MCP_ALLOWED_ORIGINS=

# Outbound email (Mailhog in dev, real SMTP in prod).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@confluent.local

# HS256 signing key for JWT access tokens (Story 6.3). Minimum 32 chars. Rotate in production.
JWT_SECRET=dev-secret-change-me-32-bytes-minimum-abc

# HS256 signing key for refresh tokens (Story 6.3, rotation). Minimum 32 chars.
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-32-bytes-abc

# Stockage des documents : bucket S3 de dev (Garage). Identifiants fournis à part (jamais dans le dépôt).
# STORAGE_DRIVER=memory garde les fichiers en mémoire (perdus à l'arrêt ; refusé en production).
STORAGE_DRIVER=s3
S3_ENDPOINT=<URL du S3 de dev, fournie avec les identifiants>
S3_REGION=garage
S3_BUCKET=confluent-dev
S3_ACCESS_KEY=<clé d'accès du bucket de dev>
S3_SECRET_KEY=<secret du bucket de dev>

# ── Swagger / OpenAPI docs (mounted at /api/docs) ───────────────────────────
# Enabled by default. Set to "false" to fully disable (e.g. hardened prod).
SWAGGER_ENABLED=true
# Basic Auth credentials — enforced only when NODE_ENV=production. Dev = open access.
SWAGGER_USER=admin
SWAGGER_PASSWORD=change-me-in-prod-min-8-chars

# ── Seed (dev only) ─────────────────────────────────────────────────────────
# If set, `pnpm db:seed` upserts this user as an active admin. Leave empty in prod.
SEED_ADMIN_EMAIL=

# ── Production compose (docker-compose.prod.yml only) ───────────────────────
# Tag of the built API image, e.g. ghcr.io/confluent/api:sha-abc.
API_IMAGE=confluent-api:latest
# Postgres credentials for the prod postgres service (must match DATABASE_URL).
POSTGRES_USER=confluent
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=confluent
